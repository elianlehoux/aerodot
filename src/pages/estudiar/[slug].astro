---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import BrandMark from '../../components/BrandMark.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LibrarySidebar from '../../components/LibrarySidebar.astro';
import StudyDiagram from '../../components/StudyDiagram.astro';
import { chapters } from '../../data/library-course.js';
import { getLibraryOrder } from '../../data/library-nav.js';
import { EXAM_LINK_LABEL, LIBRARY_ONLY_REASON } from '../../data/library-course.js';
import { lessonSlugs, legacyAnchorMap } from '../../data/lesson-anchors.js';
import { parseParagraph, lessonDiagrams } from '../../data/lesson-blocks.js';
export function getStaticPaths() { return chapters.map((chapter) => ({ params: { slug: chapter.slug }, props: { chapter } })); }
const { chapter } = Astro.props;
// Orden canónico de lectura: el mismo del índice de /temas y del sidebar.
const libraryOrder = getLibraryOrder();
const orderIndex = libraryOrder.findIndex((entry) => entry.slug === chapter.slug);
const previous = orderIndex > 0 ? libraryOrder[orderIndex - 1] : null;
const next = orderIndex > -1 && orderIndex < libraryOrder.length - 1 ? libraryOrder[orderIndex + 1] : null;
// Se muestran TODAS las fuentes del capitulo, con su tipo a la vista. Antes solo se
// listaban las no argentinas, y un capitulo compuesto solo por fuentes oficiales
// (regulaciones) se quedaba sin ninguna cita visible.
const kindLabel = (source) => source.kind === 'Argentina' ? 'Fuente oficial' : source.kind;
const sortedSources = [...chapter.sources].sort((a, b) => Number(b.kind === 'Argentina') - Number(a.kind === 'Argentina'));
// Los tipos de párrafo (texto, nota US, ecuación, tabla, lista) están en lesson-blocks.js.
// Cada lección se ancla con el slug de su título; los enlaces viejos #leccion-N siguen andando.
const slugs = lessonSlugs(chapter.lessons);
const legacyBySlug = Object.entries(legacyAnchorMap(chapter)).reduce((acc, [anchor, slug]) => ({ ...acc, [slug]: [...(acc[slug] ?? []), anchor] }), {});
const mathParts = (text) => text.split(/(_[\p{L}\d]+)/u).filter(Boolean).map((part) => part.startsWith('_') ? { sub: part.slice(1) } : { text: part });
const plainMath = (text) => text.replace(/_([\p{L}\d]+)/gu, '$1');
const formatLesson = (lesson) => {
  const body = lesson[1].split(/\n\n+/).map((paragraph) => {
    const block = parseParagraph(paragraph);
    if (block.kind === 'us') return `> **En Estados Unidos.** ${block.text}`;
    if (block.kind === 'eq') return [`**Ecuación:** ${plainMath(block.formula)}`, ...block.terms.map(([symbol, meaning]) => `- ${plainMath(symbol)}: ${meaning}`)].join('\n');
    if (block.kind === 'table') return [block.head, block.head.map(() => '---'), ...block.rows].map((row) => `| ${row.join(' | ')} |`).join('\n');
    if (block.kind === 'list') return [block.lead, ...block.items.map((item, n) => `${block.ordered ? `${n + 1}.` : '-'} ${item}`)].filter(Boolean).join('\n');
    return block.text;
  }).join('\n\n');
  const maneuver = lesson[4] ? [
    '### Paso a paso', lesson[4].steps.map((step, n) => `${n + 1}. ${step}`).join('\n'),
    '### Cuando sale bien', lesson[4].good.map((item) => `- ${item}`).join('\n'),
    '### Cuando sale mal', lesson[4].bad.map(([error, fix]) => `- **${error}** ${fix}`).join('\n'),
    '### Por qué se hace así', ...lesson[4].why,
    ...lesson[4].notes.map((text) => `> **Nota.** ${text}`),
    ...lesson[4].us.map((text) => `> **En Estados Unidos.** ${text}`),
  ].join('\n\n') : '';
  return [`## ${lesson[0]}`, body, maneuver, lesson[2] && `**Idea para recordar:** ${lesson[2]}`].filter(Boolean).join('\n\n');
};
const rememberLines = (text) => text.split(/(?<=\.)\s+/).map((sentence) => {
  const separator = sentence.indexOf(':');
  return separator > 0 && separator <= 30
    ? { label: sentence.slice(0, separator + 1), detail: sentence.slice(separator + 1) }
    : { detail: sentence };
});
const articleCopyText = [
  `# ${chapter.title}`,
  chapter.intro,
  ...chapter.lessons.map(formatLesson),
  sortedSources.length
    ? `## Fuentes\n\n${sortedSources.map((source) => `- [${source.title}](${source.url}): ${kindLabel(source)}`).join('\n')}`
    : '',
].filter(Boolean).join('\n\n');

const pageTitle = `${chapter.title}: teoría aeronáutica y fundamentos | Aerodot`;
const trimmedIntro = chapter.intro.length > 130 ? `${chapter.intro.slice(0, 130)}...` : chapter.intro;
const pageDescription = `${trimmedIntro} Lección con fuentes de normativa RAAC y manuales de vuelo.`;

const englishBridge = {
  'operaciones-aerodromo': { href: '/ingles/aerodromo', label: 'Estas palabras, en inglés' },
  meteorologia: { href: '/ingles/atis', label: 'Leer un ATIS en inglés' },
}[chapter.slug];

const articleJsonLd = {
  '@type': 'Article',
  headline: `${chapter.title}: teoría de aviación`,
  description: chapter.intro,
  inLanguage: 'es-AR',
  publisher: {
    '@type': 'Organization',
    name: 'Aerodot',
  },
};
---
<BaseLayout title={pageTitle} description={pageDescription} ogType="article" jsonLd={articleJsonLd}>
  <header class="site-header study-header"><BrandMark /><SiteNav current="biblioteca" /></header>
  <div class="library-shell">
  <LibrarySidebar activeSlug={chapter.slug} />
  <main class="study-page" id="main-content" tabindex="-1">
    <section class="study-intro"><p class="eyebrow">Biblioteca abierta</p><h1>{chapter.title}<span>.</span></h1><p class="study-deck" data-report-target data-report-where={`${chapter.title} · introducción`} data-report-ref={`/estudiar/${chapter.slug}`}>{chapter.intro}</p></section>
    <aside class="library-toc study-page-toc" aria-label="Índice del capítulo">
      <button class="library-copy-page" type="button" data-copy-page>
        <animate-icons name="copy" size="14"></animate-icons>
        <span>Copiar página</span>
      </button>
      <span class="library-copy-status" data-copy-status aria-live="polite"></span>
      <details class="chapter-toc">
        <summary>En esta página</summary>
        <nav aria-label="Secciones del capítulo">
          {chapter.lessons.map((lesson, i) => <a href={`#${slugs[i]}`}>{lesson[0]}</a>)}
          {sortedSources.length > 0 && <a href="#material">Fuentes</a>}
        </nav>
      </details>
    </aside>
    <div class="study-layout"><article class="study-content">
      {chapter.lessons.map((lesson, i) => {
        const ref = `/estudiar/${chapter.slug}#${slugs[i]}`;
        const place = `${chapter.title} · ${lesson[0]}`;
        const diagrams = lessonDiagrams(lesson);
        return <section class="study-lesson" id={slugs[i]}>{(legacyBySlug[slugs[i]] ?? []).map((anchor) => <span class="legacy-anchor" id={anchor} aria-hidden="true"></span>)}<h2>{lesson[0]}</h2>{lesson[1].split(/\n\n+/).map((paragraph) => {
          const block = parseParagraph(paragraph);
          if (block.kind === 'eq') {
            return <figure class="study-eq" data-report-target data-report-where={`Ecuación · ${place}`} data-report-ref={ref}>
              <p class="study-eq-formula">{mathParts(block.formula).map((part) => part.sub ? <sub>{part.sub}</sub> : part.text)}</p>
              <dl class="study-eq-terms">{block.terms.map(([symbol, meaning]) => <div><dt>{mathParts(symbol).map((part) => part.sub ? <sub>{part.sub}</sub> : part.text)}</dt><dd>{meaning}</dd></div>)}</dl>
            </figure>;
          }
          if (block.kind === 'table') {
            return <div class="study-table-wrap" data-report-target data-report-where={`Tabla · ${place}`} data-report-ref={ref}><table class="study-table">
              <thead><tr>{block.head.map((cell) => <th scope="col">{cell}</th>)}</tr></thead>
              <tbody>{block.rows.map(([first, ...rest]) => <tr><th scope="row">{first}</th>{rest.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
            </table></div>;
          }
          if (block.kind === 'list') {
            const items = block.items.map((item) => <li>{item}</li>);
            return <div class="study-list" data-report-target data-report-where={`Lección · ${place}`} data-report-ref={ref}>{block.lead && <p>{block.lead}</p>}{block.ordered ? <ol>{items}</ol> : <ul>{items}</ul>}</div>;
          }
          return block.kind === 'us'
            ? <aside class="us-note" data-report-target data-report-where={`En Estados Unidos · ${place}`} data-report-ref={ref}><span>En Estados Unidos</span><p>{block.text}</p></aside>
            : <p data-report-target data-report-where={`Lección · ${place}`} data-report-ref={ref}>{block.text}</p>;
        })}{diagrams.map((type, k) => <StudyDiagram type={type} instance={`${chapter.slug}-${slugs[i]}${diagrams.length > 1 ? `-${k + 1}` : ''}`} reportWhere={`Diagrama · ${place}`} reportRef={ref} />)}{lesson[4] && <div class="maneuver">
          <h3>Paso a paso</h3>
          <ol class="maneuver-steps">{lesson[4].steps.map((step) => <li data-report-target data-report-where={`Paso a paso · ${place}`} data-report-ref={ref}>{step}</li>)}</ol>
          <h3>Cuando sale bien</h3>
          <ul class="maneuver-good">{lesson[4].good.map((item) => <li data-report-target data-report-where={`Cuando sale bien · ${place}`} data-report-ref={ref}>{item}</li>)}</ul>
          <h3>Cuando sale mal</h3>
          <ul class="maneuver-errors">{lesson[4].bad.map(([error, fix]) => <li data-report-target data-report-where={`Cuando sale mal · ${place}`} data-report-ref={ref}><strong>{error}</strong> {fix}</li>)}</ul>
          <h3>Por qué se hace así</h3>
          {lesson[4].why.map((paragraph) => <p class="maneuver-why" data-report-target data-report-where={`Por qué · ${place}`} data-report-ref={ref}>{paragraph}</p>)}
          {lesson[4].notes.map((text) => <aside class="learning-note maneuver-note" data-report-target data-report-where={`Nota · ${place}`} data-report-ref={ref}><span>NOTA</span><p>{text}</p></aside>)}
          {lesson[4].us.map((text) => <aside class="us-note" data-report-target data-report-where={`En Estados Unidos · ${place}`} data-report-ref={ref}><span>En Estados Unidos</span><p>{text}</p></aside>)}
        </div>}{lesson[2] && <aside class="learning-note" data-report-target data-report-where={`Idea para recordar · ${place}`} data-report-ref={ref}><span>IDEA PARA RECORDAR</span><p>{rememberLines(lesson[2]).map(({ label, detail }) => <span class="learning-note-line">{label && <strong>{label}</strong>}{detail}</span>)}</p></aside>}</section>;
      })}
      <div class="study-report">
        <button class="page-report" type="button" data-report-page data-report-where={chapter.title} data-report-ref={`/estudiar/${chapter.slug}`} data-report-excerpt={chapter.title}>Avisar un error en esta página</button>
      </div>
      {sortedSources.length > 0 && <section class="study-sources" id="material">
        <h2>Fuentes</h2>
        <p>Primero las oficiales argentinas y después el material de contraste. Contrastá normativa y procedimientos vigentes antes de aplicarlos.</p>
        <ul>{sortedSources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a><small>{kindLabel(source)}</small></li>)}</ul>
      </section>}
      <section class="chapter-finish"><h2>¿Te queda claro?</h2><p>{chapter.examChapterId ? `Marcá el tema como estudiado. Forma parte del temario del ${EXAM_LINK_LABEL}, así que podés practicar sus preguntas.` : `Marcá el tema como estudiado. ${LIBRARY_ONLY_REASON}`}</p><div><button class="button-primary" type="button" data-complete={chapter.slug} aria-pressed="false"><span data-complete-label>Marcar como estudiado</span> <span aria-hidden="true">✓</span></button>{chapter.examChapterId ? <a class="button-quiet" href={`/examenes/ppa?chapter=${chapter.examChapterId}`}>Practicar preguntas de este tema <span>→</span></a> : <a class="button-quiet" href="/temas">Volver al índice de temas <span>→</span></a>}{englishBridge && <a class="button-quiet" href={englishBridge.href}>{englishBridge.label} <span>→</span></a>}</div><p class="saved-state" aria-live="polite"></p></section>
      <nav class="chapter-pagination">{previous ? <a href={`/estudiar/${previous.slug}`}><small>← ANTERIOR</small><b>{previous.title}</b></a> : <span></span>}{next ? <a class="next-chapter" href={`/estudiar/${next.slug}`}><small>SIGUIENTE →</small><b>{next.title}</b></a> : <a class="next-chapter" href="/examenes"><small>PRÓXIMO PASO →</small><b>Ir a exámenes</b></a>}</nav>
      <p class="progress-notice" data-progress-notice aria-live="polite"></p>
    </article></div>
  </main>
  </div>
  <SiteFooter><BrandMark /><span>Material didáctico complementario para estudiar aviación.</span>{sortedSources.length > 0 && <a href="#material">Ver fuentes ↗</a>}</SiteFooter>
  <script>
    import '../../scripts/study-progress.js';
  </script>
  <script is:inline define:vars={{articleCopyText, chapterSlug: chapter.slug}}>
    const copyButton=document.querySelector('[data-copy-page]');
    const copyStatus=document.querySelector('[data-copy-status]');
    copyButton.addEventListener('click',async()=>{
      copyStatus.textContent='';
      try {
        await navigator.clipboard.writeText(articleCopyText);
        window.posthog?.capture('study_page_copied', { chapter_slug: chapterSlug });
        copyStatus.textContent='Página copiada.';
      } catch {
        copyStatus.textContent='No se pudo copiar. Revisá los permisos del navegador.';
      }
    });
    const chapterToc=document.querySelector('.chapter-toc');
    const chapterTocSummary=chapterToc?.querySelector('summary');
    const wideToc=window.matchMedia('(min-width: 1181px)');
    const syncChapterToc=()=>{
      if(!chapterToc||!chapterTocSummary)return;
      if(wideToc.matches)chapterToc.open=true;
      chapterTocSummary.tabIndex=wideToc.matches?-1:0;
    };
    syncChapterToc();
    wideToc.addEventListener('change',syncChapterToc);
    const tocLinks=[...document.querySelectorAll('.study-page-toc nav a')];
    const tocTargets=tocLinks.map((link)=>document.querySelector(link.getAttribute('href'))).filter(Boolean);
    if('IntersectionObserver' in window){
      const observer=new IntersectionObserver((entries)=>{
        const visible=entries.filter((entry)=>entry.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top)[0];
        if(!visible)return;
        tocLinks.forEach((link) => {
          // Se quita el atributo en vez de escribir aria-current="false": el resto del sitio
          // representa "no actual" omitiendo el atributo.
          if (link.hash === `#${visible.target.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      },{rootMargin:'-12% 0px -72% 0px',threshold:0});
      tocTargets.forEach((target)=>observer.observe(target));
    }
  </script>
</BaseLayout>
