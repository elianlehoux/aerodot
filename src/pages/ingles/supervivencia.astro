---
import EnglishShell from '../../components/EnglishShell.astro';
import EnglishFinish from '../../components/EnglishFinish.astro';
import EnglishSay from '../../components/EnglishSay.astro';
import ExerciseSet from '../../components/ExerciseSet.astro';
import { survivalSet } from '../../data/english-sets.js';
import { survivalCall, survivalGroups } from '../../data/english-survival.js';
import '../../styles/english-survival.css';

/** Parte un texto en español: lo que va entre asteriscos es inglés y lleva lang="en". */
const mixed = (text) => text.split('*').map((piece, index) => ({ piece, en: index % 2 === 1 }));
const who = { tower: 'Torre', pilot: 'Vos' };
---
<EnglishShell
  title="Frases de supervivencia — Inglés aeronáutico | Aerodot"
  description="Qué decir por radio, en inglés aeronáutico, cuando no entendiste, no podés o te equivocaste. Tarjetas con audio, una llamada de ejemplo y una práctica corta."
>
  <a class="back-link" href="/ingles">← Inglés</a>
  <p class="eyebrow">Base</p>
  <h1>Frases de supervivencia.</h1>
  <p class="en-deck">Las palabras que más vas a usar cuando algo no sale bien: no entendiste, no podés o te equivocaste.</p>

  <aside class="library-toc study-page-toc" aria-label="Índice de la página">
    <details class="chapter-toc" data-sv-toc open>
      <summary>En esta página</summary>
      <nav aria-label="Secciones del tema">
        {survivalGroups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
        <a href="#llamada">Una llamada con problemas</a>
        <a href={`#${survivalSet.id}-title`}>{survivalSet.title}</a>
      </nav>
    </details>
  </aside>

  {survivalGroups.map((group) => (
    <section class="radio-block" aria-labelledby={group.id}>
      <h2 id={group.id}>{group.title}</h2>
      <p>{mixed(group.lede).map(({ piece, en }) => en ? <em lang="en">{piece}</em> : piece)}</p>
      <ul class="flip-grid" role="list">
        {[...group.phrases, ...(group.aside ? [group.aside] : [])].map((item) => (
          <li class:list={['flip', { 'sv-aside': item.tag }]} data-flip>
            {item.tag && <span class="sv-tag">{item.tag}</span>}
            <div class="word-head">
              <h3 lang="en">{item.en}</h3>
              <EnglishSay text={item.say} label={`Escuchar ${item.en}`} quiet />
            </div>
            <p class="flip-say" lang="en">“{item.use}”</p>
            <div class="flip-back" id={`flip-${item.id}`} hidden>
              <p class="flip-es">{item.es}</p>
              <p>{mixed(item.body).map(({ piece, en }) => en ? <em lang="en">{piece}</em> : piece)}</p>
            </div>
            <button class="flip-toggle" type="button" data-reveal aria-controls={`flip-${item.id}`} aria-expanded="false"><span data-reveal-label>Qué significa</span></button>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="en-block" aria-labelledby="llamada">
    <h2 id="llamada">Una llamada con problemas</h2>
    <p class="en-block-lede">Rodaje en Laguna. Se pierde un pedazo, se colaciona mal y se corrige. Lo resaltado son las frases de supervivencia.</p>
    <ol class="sv-call" role="list">
      {survivalCall.map((line) => (
        <li class:list={['sv-line', `is-${line.who}`]}>
          <span class="sv-who">{who[line.who]}</span>
          <div class="sv-bubble">
            <p lang="en">{line.parts.map((part) => part.hl ? <mark class="sv-hl">{part.text}</mark> : part.text)}</p>
            <EnglishSay text={line.say} label={line.who === "tower" ? "Escuchar a la torre" : "Escuchar al piloto"} quiet />
          </div>
          <p class="sv-note">{mixed(line.note).map(({ piece, en }) => en ? <em lang="en">{piece}</em> : piece)}</p>
        </li>
      ))}
    </ol>
  </section>

  <ExerciseSet set={survivalSet} />

  <p class="en-sources">Los significados siguen la tabla de palabras y frases normalizadas de la OACI (Anexo 10, Vol. II, cap. 5) y la fraseología del Doc 4444, cap. 12; el uso de EE. UU., el Glosario Piloto/Controlador de la FAA. El aeródromo Laguna, la matrícula LV-DEM y los números de los ejemplos son de práctica: no se usan para volar. El audio usa la voz de tu navegador.</p>

  <EnglishFinish slug="supervivencia" where="Frases de supervivencia" />
  <script>
    import { mountEnglishProgress, mountListen, mountReveals } from '../../scripts/english.js';
    import { mountExerciseSets } from '../../scripts/exercises/engine.js';
    mountListen();
    mountEnglishProgress();
    mountReveals();
    mountExerciseSets();

    // Guía lateral: abierta en pantalla ancha, plegable en el celular. Marca la sección que estás leyendo.
    const toc = document.querySelector('[data-sv-toc]');
    const wide = window.matchMedia('(min-width: 1181px)');
    const sync = () => {
      if (wide.matches) toc.open = true;
      toc.querySelector('summary').tabIndex = wide.matches ? -1 : 0;
    };
    sync();
    wide.addEventListener('change', sync);
    // Si una sección no está (o quedó oculta, como un set inválido), su enlace se saca del índice.
    const links = [...toc.querySelectorAll('nav a')].filter((link) => {
      const target = document.querySelector(link.getAttribute('href'));
      if (target && !target.closest('[hidden]')) return true;
      link.hidden = true;
      return false;
    });
    const targets = links.map((link) => document.querySelector(link.getAttribute('href')));
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        links.forEach((link) => {
          if (link.hash === `#${visible.target.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }, { rootMargin: '-12% 0px -72% 0px', threshold: 0 });
      targets.forEach((target) => observer.observe(target));
    }
  </script>
</EnglishShell>
