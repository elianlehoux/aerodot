---
import EnglishShell from '../../components/EnglishShell.astro';
import EnglishCrumbs from '../../components/EnglishCrumbs.astro';
import EnglishFinish from '../../components/EnglishFinish.astro';
import EnglishPart from '../../components/EnglishPart.astro';
import EnglishToc from '../../components/EnglishToc.astro';
import EnglishSay from '../../components/EnglishSay.astro';
import ExerciseSet from '../../components/ExerciseSet.astro';
import { radioFailSet } from '../../data/english-sets.js';
import { blindMessages, checkWords, controlChecks, relayCall } from '../../data/english-radiofail.js';
import { splitKey, splitMixed } from '../../scripts/mixed.js';
import '../../styles/english-survival.css';
import '../../styles/english-comms.css';

const kindLabel = { call: 'llamás', readback: 'colacionás', action: 'hacés' };
const speaker = (line: { who: string; unit?: string }) => (line.who === 'pilot' ? 'Vos' : line.unit ?? 'Laguna Tower');
type Line = { who: string; unit?: string; kind?: string; text: string; say?: string; key?: string; note?: string };
const calls: { id: string; title: string; lines: Line[] }[] = [
  ...controlChecks.map((check) => ({ id: check.id, title: check.title, lines: check.call })),
  { id: 'relay', title: 'Pedir un relevo', lines: relayCall },
];
---
<EnglishShell
  title="Falla de radio: inglés aeronáutico | Aerodot"
  description="Qué se dice en inglés cuando la radio falla: la transmisión a ciegas, cómo te prueba el control y cómo le pedís a otro avión que pase tu mensaje. Con audio y una práctica corta."
>
  <EnglishCrumbs slug="falla-radio" />
  <h1>Falla de radio.</h1>

  <EnglishToc learn={[{href:'#ciegas',label:'Transmitir a ciegas'},{href:'#prueba',label:'Si el control te prueba'},{href:'#relevo',label:'Pedir un relevo'}]} practice={[{href:`#${radioFailSet.id}-title`,label:radioFailSet.title}]} />

  <EnglishPart kind="learn">

  <section class="radio-block" aria-labelledby="ciegas">
    <h2 id="ciegas">Transmitir a ciegas</h2>
    <div class="fr-blind-grid">
      {blindMessages.map((message) => (
        <article class="fr-blind" aria-labelledby={`fr-${message.id}`}>
          <h3 id={`fr-${message.id}`} lang="en">{message.en}</h3>
          <p class="fr-blind-es">{message.es}</p>
          <p class="fr-blind-when">{message.when}</p>
          <ol class="fr-parts" role="list">
            {message.parts.map((part) => (
              <li>
                <span class="fr-part-label">{part.label}</span>
                <span class="fr-part-text" lang="en">{part.text}</span>
              </li>
            ))}
          </ol>
          <EnglishSay text={message.say} label={`Escuchar el mensaje completo: *${message.en.toLowerCase()}*`} />
        </article>
      ))}
    </div>
  </section>

  <section class="radio-block" aria-labelledby="prueba">
    <h2 id="prueba">Si el control te prueba</h2>
    <p>No contestás con la voz: con el transpondedor o con la maniobra.</p>
    <dl class="fr-words">
      {checkWords.map((word) => (
        <div>
          <dt lang="en">{word.en}</dt>
          <dd>{word.es}</dd>
        </div>
      ))}
    </dl>
  </section>

  {calls.map((call) => (
    <section class:list={['radio-block', { 'fr-sub-block': call.id !== 'relay' }]} aria-labelledby={call.id === 'relay' ? 'relevo' : `fr-${call.id}`}>
      {call.id === 'relay'
        ? <>
            <h2 id="relevo">Pedir un relevo</h2>
          </>
        : <>
            <h3 id={`fr-${call.id}`} class="fr-sub">{call.title}</h3>
          </>}
      <ol class="sv-call er-call" role="list">
        {call.lines.map((line, n) => (
          <li class:list={['sv-line', `is-${line.who === 'other' ? 'tower' : line.who}`]}>
            <span class="sv-who">{line.who === 'pilot' ? <>Vos · {kindLabel[line.kind as keyof typeof kindLabel]}</> : <span lang="en">{speaker(line)}</span>}</span>
            {line.kind === 'action'
              ? <p class="fr-action">{line.text}</p>
              : <div class="sv-bubble">
                  <p lang="en">{splitKey(line.text, line.key).map((part) => part.hl ? <mark class="sv-hl">{part.text}</mark> : part.text)}</p>
                  <EnglishSay text={line.say!} label={`${line.who === 'pilot' ? 'Escuchar tu llamada' : `Escuchar a *${speaker(line)}*`}, mensaje ${n + 1}: ${call.title.toLowerCase()}`} quiet />
                </div>}
            {line.note && <p class="sv-note">{splitMixed(line.note).map((part) => part.en ? <em lang="en">{part.text}</em> : part.text)}</p>}
          </li>
        ))}
      </ol>
    </section>
  ))}

  </EnglishPart>

  <EnglishPart kind="practice">
  <ExerciseSet set={radioFailSet} />

  </EnglishPart>

  <p class="en-sources">Las frases siguen SERA, el manual de radio británico (CAP 413) y la fraseología de la OACI. Laguna, las matrículas y las cifras son de práctica y no se usan para volar.</p>

  <EnglishFinish slug="falla-radio" where="Falla de radio" />
  <script>
    import { mountEnglishProgress, mountListen, mountPageToc } from '../../scripts/english.js';
    import { mountExerciseSets } from '../../scripts/exercises/engine.js';
    mountListen();
    mountEnglishProgress();
    mountExerciseSets();
    mountPageToc('[data-page-toc]');
  </script>
</EnglishShell>
