---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import BrandMark from '../components/BrandMark.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeChart from '../components/HomeChart.astro';
import '../styles/chart-home.css';
---
<BaseLayout
  title="Aerodot: biblioteca de aviación y exámenes ANAC en Argentina"
  description="Estudiá teoría aeronáutica y practicá con simuladores de exámenes ANAC para Piloto Privado (PPA), Comercial (PCA), Instructor y más. Gratis y sin registro."
>
  <div class="home-page">
    <header class="site-header">
      <BrandMark />
      <SiteNav home />
    </header>
    <main id="main-content" tabindex="-1">
      <section class="home-stage">
        <HomeChart variant="wide" />
        <HomeChart variant="tall" />
        <h1>Entender la aviación,<br/><em>tema por tema.</em></h1>
        <p class="hero-lede">Conceptos explicados con claridad y detalle técnico. Consultá lo que necesitás y practicá hasta rendir el examen.</p>
        <a class="home-door home-door-1 key-button" href="/temas">Biblioteca de teoría<span class="key-button-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
        <a class="home-door home-door-2 key-button" href="/examenes">Exámenes de ANAC<span class="key-button-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
        <a class="home-door home-door-3 key-button" href="/ingles">Inglés OACI<span class="key-button-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
      </section>
    </main>
    <SiteFooter variant="home">
      <small slot="note">Material independiente. No reemplaza instrucción, documentación aeronáutica ni normativa vigente.</small>
    </SiteFooter>
  </div>
</BaseLayout>
