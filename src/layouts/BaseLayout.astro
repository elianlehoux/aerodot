---
import '../styles/global.css';
import '../styles/visual-system.css';
import ReportDialog from '../components/ReportDialog.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import PostHog from '../components/posthog.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title = 'Aerodot — Biblioteca de Aviación y Simulador de Exámenes ANAC',
  description = 'Aprendé los fundamentos de la aviación, paso a paso y en lenguaje claro. Practicá con bancos de preguntas de exámenes ANAC en Argentina.',
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://aerodot.app').replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = new URL('/logo.png', siteOrigin).href;

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      url: siteOrigin,
      name: 'Aerodot',
      description: 'Biblioteca abierta de aviación y práctica de exámenes por licencia en Argentina.',
      inLanguage: 'es-AR',
    },
    ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1b1a18" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="google-site-verification" content="e3f28597bbbdc0a5" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph / Redes Sociales (WhatsApp, LinkedIn, Facebook) -->
    <meta property="og:site_name" content="Aerodot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Datos estructurados Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('aerodot:theme') || localStorage.getItem('altura:theme');
          const theme = savedTheme === 'light' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Aerodot" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="application-name" content="Aerodot" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-italic.woff2" as="font" type="font/woff2" crossorigin />
    <PostHog />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <slot />
    <ReportDialog />
    <InstallPrompt />
    <a class="back-to-top" href="#top" aria-label="Volver arriba" title="Volver arriba" aria-hidden="true" tabindex="-1">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5m-6 6 6-6 6 6" /></svg>
    </a>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const controls = document.querySelectorAll('.ld-dn');
        const themeColor = document.querySelector('meta[name="theme-color"]');
        const update = (theme) => {
          const isNight = theme === 'dark';
          root.dataset.theme = isNight ? 'dark' : 'light';
          controls.forEach((control) => {
            control.setAttribute('aria-checked', String(isNight));
            const label = isNight ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro';
            control.setAttribute('aria-label', label);
            control.setAttribute('title', label);
          });
          if (themeColor) themeColor.setAttribute('content', isNight ? '#1b1a18' : '#fdfcfc');
        };

        update(root.dataset.theme || 'dark');
        controls.forEach((control) => control.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          update(nextTheme);
          try { localStorage.setItem('aerodot:theme', nextTheme); } catch { /* El tema sigue activo en esta visita. */ }
        }));
      })();
    </script>
    <script is:inline>
      (() => {
        const control = document.querySelector('.back-to-top');
        if (!control) return;

        const footer = document.querySelector('.home-footer');
        const updateVisibility = () => {
          // Cuando el footer entra en pantalla, el botón sube con él para no taparle los links.
          const lift = footer ? Math.max(0, window.innerHeight - footer.getBoundingClientRect().top) : 0;
          document.documentElement.style.setProperty('--footer-lift', `${Math.round(lift)}px`);
          const visible = window.scrollY > 320 || document.activeElement === control;
          control.classList.toggle('is-visible', visible);
          control.setAttribute('aria-hidden', String(!visible));
          control.tabIndex = visible ? 0 : -1;
        };

        window.addEventListener('scroll', updateVisibility, { passive: true });
        window.addEventListener('resize', updateVisibility, { passive: true });
        control.addEventListener('blur', updateVisibility);
        updateVisibility();
      })();
    </script>
    {import.meta.env.PROD && <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => { /* El sitio funciona igual sin modo offline. */ });
        });
      }
    </script>}
  </body>
</html>
