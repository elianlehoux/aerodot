---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  current?: 'biblioteca' | 'examenes' | 'ingles' | 'plan' | null;
}

const { current = null } = Astro.props;
---
<nav aria-label="Navegación principal">
  <a href="/temas" aria-current={current === 'biblioteca' ? 'page' : undefined}>Biblioteca</a>
  <a href="/examenes" aria-current={current === 'examenes' ? 'page' : undefined}>Exámenes</a>
  <a href="/ingles" aria-current={current === 'ingles' ? 'page' : undefined}>Inglés</a>
  <a href="/plan" aria-current={current === 'plan' ? 'page' : undefined}>Plan</a>
  <ThemeToggle />
</nav>
