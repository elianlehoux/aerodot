---
/**
 * Preguntas frecuentes visibles. La página arma el JSON-LD FAQPage con `faqJsonLd` usando
 * los mismos ítems, así lo que lee Google es exactamente lo que ve la persona.
 */
interface Props {
  id?: string;
  title?: string;
  items: Array<{ question: string; answer: string }>;
}

const { id = 'preguntas-frecuentes', title = 'Preguntas frecuentes', items } = Astro.props;
---
<section class="faq-block" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  {items.map((item) => <details class="faq-item">
    <summary>{item.question}</summary>
    <p>{item.answer}</p>
  </details>)}
</section>
