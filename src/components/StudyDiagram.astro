    <text x="96" y={isa.y(11) + 24} class="t c-weight">−56,5 °C</text>
    <text x="168" y="236" text-anchor="end" class="ts">baja 6,5 °C</text>
    <text x="168" y="258" text-anchor="end" class="ts">cada 1000 m</text>
    <text x="74" y={isa.y(11) - 8} class="ts">Tropopausa (≈ 11 km)</text>
    <text x="294" y="296" class="tb">1013 hPa</text>
    <text x="294" y="326" class="ts">nivel del mar</text>
    <text x="294" y={isa.y(5.5) + 6} class="tb">≈ 500 hPa</text>
    <text x="294" y={isa.y(5.5) + 30} class="ts">la mitad del aire</text>
    <text x="294" y={isa.y(5.5) + 52} class="ts">quedó abajo</text>
    <text x="294" y={isa.y(11) + 26} class="tb">≈ 226 hPa</text>
  </svg>}

