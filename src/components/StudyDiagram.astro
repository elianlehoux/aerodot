    <rect x="198" y="46" width="158" height="120" rx="8" class="node" /><text x="277" y="86" text-anchor="middle" class="label">Hipémica</text><text x="277" y="112" text-anchor="middle" class="small">la sangre transporta</text><text x="277" y="130" text-anchor="middle" class="small">menos · CO, anemia</text>
    <rect x="372" y="46" width="158" height="120" rx="8" class="node" /><text x="451" y="86" text-anchor="middle" class="label">Estancamiento</text><text x="451" y="112" text-anchor="middle" class="small">la sangre no llega</text><text x="451" y="130" text-anchor="middle" class="small">G · circulación</text>
    <rect x="546" y="46" width="150" height="120" rx="8" class="node" /><text x="621" y="86" text-anchor="middle" class="label">Histotóxica</text><text x="621" y="112" text-anchor="middle" class="small">el tejido no lo usa</text><text x="621" y="130" text-anchor="middle" class="small">alcohol · tóxicos</text>
    <text x="360" y="204" text-anchor="middle" class="caption">El juicio suele fallar antes de que la persona note el problema.</text>
  </svg>}

  {type === 'priority' && <svg viewBox="0 0 720 210" role="img" aria-labelledby={`diagram-title-priority-${uid} diagram-desc-priority-${uid}`}>
    <title id={`diagram-title-priority-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-priority-${uid}`}>Tres pasos en orden: controlar la aeronave, elegir una trayectoria alcanzable y comunicar. La comunicación no reemplaza el control.</desc>
    <defs><marker id={`arrow-priority-${uid}`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="currentColor" /></marker></defs>
    <rect x="24" y="48" width="190" height="96" rx="8" class="node node-accent" /><text x="119" y="86" text-anchor="middle" class="label label-blue">1 · Controlar</text><text x="119" y="110" text-anchor="middle" class="small">actitud, velocidad</text>
    <rect x="264" y="48" width="190" height="96" rx="8" class="node" /><text x="359" y="86" text-anchor="middle" class="label">2 · Orientar</text><text x="359" y="110" text-anchor="middle" class="small">una opción alcanzable</text>
    <rect x="504" y="48" width="190" height="96" rx="8" class="node" /><text x="599" y="86" text-anchor="middle" class="label">3 · Comunicar</text><text x="599" y="110" text-anchor="middle" class="small">posición e intención</text>
    <path d="M214 96H264M454 96H504" class="pipe pipe-blue" marker-end="url(#arrow-priority-${uid})" />
    <text x="360" y="182" text-anchor="middle" class="caption">Es un orden para entrenar la atención, no un artículo de la RAAC.</text>
  </svg>}

  {type === 'metar' && <svg viewBox="0 0 760 230" role="img" aria-labelledby={`diagram-title-metar-${uid} diagram-desc-metar-${uid}`}>
    <title id={`diagram-title-metar-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-metar-${uid}`}>Siete grupos de un METAR de ejemplo: lugar, fecha y hora, viento, visibilidad, nubes, temperatura y rocío, y presión QNH.</desc>
    <rect x="12" y="36" width="92" height="64" rx="8" class="node" /><text x="58" y="64" text-anchor="middle" class="label">SAEZ</text><text x="58" y="84" text-anchor="middle" class="small">lugar</text>
    <rect x="114" y="36" width="110" height="64" rx="8" class="node" /><text x="169" y="64" text-anchor="middle" class="label">301200Z</text><text x="169" y="84" text-anchor="middle" class="small">día 30 · 12:00 UTC</text>
    <rect x="234" y="36" width="110" height="64" rx="8" class="node" /><text x="289" y="64" text-anchor="middle" class="label">18012KT</text><text x="289" y="84" text-anchor="middle" class="small">180° · 12 kt</text>
    <rect x="354" y="36" width="80" height="64" rx="8" class="node" /><text x="394" y="64" text-anchor="middle" class="label">9999</text><text x="394" y="84" text-anchor="middle" class="small">≥ 10 km</text>
    <rect x="444" y="36" width="100" height="64" rx="8" class="node node-accent" /><text x="494" y="64" text-anchor="middle" class="label label-blue">FEW030</text><text x="494" y="84" text-anchor="middle" class="small">pocas · 3000 ft</text>
    <rect x="554" y="36" width="86" height="64" rx="8" class="node" /><text x="597" y="64" text-anchor="middle" class="label">22/14</text><text x="597" y="84" text-anchor="middle" class="small">°C · rocío</text>
    <rect x="650" y="36" width="96" height="64" rx="8" class="node" /><text x="698" y="64" text-anchor="middle" class="label">Q1016</text><text x="698" y="84" text-anchor="middle" class="small">QNH hPa</text>
    <text x="380" y="150" text-anchor="middle" class="small">FEW, SCT, BKN y OVC cuentan octas. BKN u OVC definen techo.</text>
    <text x="380" y="176" text-anchor="middle" class="small">22/14: faltan 8 °C para la saturación. Una diferencia chica favorece niebla o nubes bajas.</text>
    <text x="380" y="208" text-anchor="middle" class="caption">Ejemplo didáctico. Leé siempre la hora, la validez y la enmienda del producto real.</text>
  </svg>}

  {type === 'cg-stability' && <svg viewBox="0 0 720 250" role="img" aria-labelledby={`diagram-title-cg-${uid} diagram-desc-cg-${uid}`}>
    <title id={`diagram-title-cg-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-cg-${uid}`}>Dos situaciones de un avión con cola convencional. Con el centro de gravedad adelantado hace falta más fuerza hacia abajo en la cola y la respuesta es más estable. Con el centro atrasado, la cola corrige menos y la estabilidad longitudinal baja.</desc>
    <defs><marker id={`arrow-cg-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker></defs>
    <path d="M70 118H210L246 126L210 134H70L40 150L28 144L52 126L28 108L40 102Z" class="aircraft" />
    <line x1="150" y1="108" x2="150" y2="62" class="force force-blue" marker-end="url(#arrow-cg-${uid})" />
    <line x1="230" y1="126" x2="230" y2="168" class="force force-muted" marker-end="url(#arrow-cg-${uid})" />
    <circle cx="118" cy="126" r="5" class="cg-point" />
    <text x="150" y="52" text-anchor="middle" class="small">sustentación</text>
    <text x="150" y="196" text-anchor="middle" class="label label-blue">CG adelante</text>
    <text x="150" y="216" text-anchor="middle" class="small">más estable · más fuerza de cola</text>
    <path d="M430 118H570L606 126L570 134H430L400 150L388 144L412 126L388 108L400 102Z" class="aircraft" />
    <line x1="510" y1="108" x2="510" y2="62" class="force force-blue" marker-end="url(#arrow-cg-${uid})" />
    <line x1="590" y1="126" x2="590" y2="156" class="force force-muted" marker-end="url(#arrow-cg-${uid})" />
    <circle cx="534" cy="126" r="5" class="cg-point" />
    <text x="510" y="196" text-anchor="middle" class="label">CG atrás</text>
    <text x="510" y="216" text-anchor="middle" class="small">menos estable · responde más</text>
    <text x="360" y="244" text-anchor="middle" class="caption">Los límites del manual ya incluyen ese margen. El esquema no los reemplaza.</text>
  </svg>}

  {type === 'stability' && <svg viewBox="0 0 640 230" role="img" aria-labelledby={`diagram-title-stability-${uid} diagram-desc-stability-${uid}`}>
    <title id={`diagram-title-stability-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-stability-${uid}`}>Tres columnas. En aire estable la parcela sube y vuelve a bajar. En aire neutro se queda donde la soltaste. En aire inestable sigue subiendo.</desc>
    <defs><marker id={`arrow-stability-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker></defs>
    <line x1="110" y1="40" x2="110" y2="168" class="guide" />
    <path d="M110 150 V78" class="force force-blue" marker-end="url(#arrow-stability-${uid})" />
    <path d="M128 96 V150" class="force force-muted" marker-end="url(#arrow-stability-${uid})" />
    <circle cx="110" cy="150" r="7" class="cg-point" />
    <text x="110" y="196" text-anchor="middle" class="label">Estable</text>
    <text x="110" y="216" text-anchor="middle" class="small">sube y vuelve</text>
    <line x1="320" y1="40" x2="320" y2="168" class="guide" />
    <path d="M320 150 V96" class="force force-blue" marker-end="url(#arrow-stability-${uid})" />
    <circle cx="320" cy="96" r="7" class="cg-point" />
    <text x="320" y="196" text-anchor="middle" class="label">Neutro</text>
    <text x="320" y="216" text-anchor="middle" class="small">se queda</text>
    <line x1="530" y1="40" x2="530" y2="168" class="guide" />
    <path d="M530 150 V48" class="force force-blue" marker-end="url(#arrow-stability-${uid})" />
    <circle cx="530" cy="48" r="7" class="cg-point" />
    <text x="530" y="196" text-anchor="middle" class="label">Inestable</text>
    <text x="530" y="216" text-anchor="middle" class="small">sigue subiendo</text>
  </svg>}

  {type === 'papi' && <svg viewBox="0 0 640 200" role="img" aria-labelledby={`diagram-title-papi-${uid} diagram-desc-papi-${uid}`}>
    <title id={`diagram-title-papi-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-papi-${uid}`}>Cuatro luces en fila. Las dos de la izquierda están blancas y las dos de la derecha rojas, la combinación habitual de senda correcta.</desc>
    <rect x="70" y="48" width="100" height="64" rx="10" fill="#f4f1ec" stroke="currentColor" />
    <rect x="190" y="48" width="100" height="64" rx="10" fill="#f4f1ec" stroke="currentColor" />
    <rect x="310" y="48" width="100" height="64" rx="10" fill="#c23b2e" stroke="currentColor" />
    <rect x="430" y="48" width="100" height="64" rx="10" fill="#c23b2e" stroke="currentColor" />
    <text x="300" y="154" text-anchor="middle" class="label">En la senda</text>
    <text x="300" y="178" text-anchor="middle" class="small">Más luces blancas: alto. Más luces rojas: bajo.</text>
  </svg>}

  {type === 'ground-reference' && <svg viewBox="0 0 640 250" role="img" aria-labelledby={`diagram-title-ground-${uid} diagram-desc-ground-${uid}`}>
    <title id={`diagram-title-ground-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-ground-${uid}`}>Un rectángulo de trayectoria sobre el suelo y una flecha de viento desde la izquierda. El tramo de viento en cola está marcado como el que pide más inclinación al virar.</desc>
    <defs><marker id={`arrow-ground-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker></defs>
    <rect x="170" y="46" width="300" height="140" rx="28" class="route" />
    <path d="M48 116 H132" class="force force-muted" marker-end="url(#arrow-ground-${uid})" />
    <text x="90" y="104" text-anchor="middle" class="small">viento</text>
    <text x="320" y="78" text-anchor="middle" class="small">viento en cara · menos banco</text>
    <text x="320" y="168" text-anchor="middle" class="label-blue">viento en cola · más banco</text>
    <text x="320" y="222" text-anchor="middle" class="small">La figura es la trayectoria sobre el suelo, no un circuito de aeródromo.</text>
  </svg>}

  {type === 'risk-matrix' && <svg viewBox="0 0 640 230" role="img" aria-labelledby={`diagram-title-risk-${uid} diagram-desc-risk-${uid}`}>
    <title id={`diagram-title-risk-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-risk-${uid}`}>Una grilla de tres por tres. Las columnas aumentan la gravedad y las filas aumentan la probabilidad. La celda de arriba a la derecha está marcada como la que se resuelve antes de salir.</desc>
    <text x="336" y="28" text-anchor="middle" class="small">gravedad →</text>
    <rect x="150" y="48" width="88" height="46" class="node" />
    <rect x="246" y="48" width="88" height="46" class="node" />
    <rect x="342" y="48" width="88" height="46" class="node-accent" />
    <rect x="150" y="102" width="88" height="46" class="node" />
    <rect x="246" y="102" width="88" height="46" class="node" />
    <rect x="342" y="102" width="88" height="46" class="node" />
    <rect x="150" y="156" width="88" height="46" class="node" />
    <rect x="246" y="156" width="88" height="46" class="node" />
    <rect x="342" y="156" width="88" height="46" class="node" />
    <text x="386" y="76" text-anchor="middle" class="label-blue">resolvé</text>
    <text x="118" y="76" text-anchor="end" class="small">alta</text>
    <text x="118" y="130" text-anchor="end" class="small">media</text>
    <text x="118" y="184" text-anchor="end" class="small">baja</text>
    <text x="194" y="220" text-anchor="middle" class="small">baja</text>
    <text x="290" y="220" text-anchor="middle" class="small">media</text>
    <text x="386" y="220" text-anchor="middle" class="small">alta</text>
  </svg>}

  <figcaption id={`diagram-caption-${uid}`}><strong>{diagramTitle}.</strong>{` ${caption}`}</figcaption>
</figure>}

<style>
  .study-diagram{position:relative;--blue:var(--violet-spark);--blue-soft:rgba(4,71,255,.08);margin:28px 0 25px;padding:18px 18px 14px;border:1px solid var(--line);border-radius:var(--radius-card);background:var(--taupe);}
  .study-diagram svg{display:block;width:100%;height:auto;color:var(--ink);overflow:visible;}
  .study-diagram .force,.study-diagram .vector,.study-diagram .pipe,.study-diagram .arm,.study-diagram .route{fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;}
  .study-diagram .force-blue,.study-diagram .vector-blue,.study-diagram .pipe-blue{color:var(--blue);stroke:var(--blue);}
  .study-diagram .force-muted,.study-diagram .vector-muted,.study-diagram .guide{color:#96918a;stroke:#96918a;}
  .study-diagram .aircraft{fill:var(--taupe);stroke:var(--ink);stroke-width:2;stroke-linejoin:round;}
  .study-diagram .vector-dark{color:#282722;stroke:#282722;}
  .study-diagram .guide{stroke-dasharray:5 7;stroke-width:1.4;}
  .study-diagram .angle{fill:none;stroke:var(--blue);stroke-width:1.8;}
  .study-diagram .center{fill:var(--ink);}
  .study-diagram .node{fill:var(--taupe);stroke:var(--line);stroke-width:1.3;}
  .study-diagram .node-accent{fill:var(--blue-soft);stroke:rgba(4,71,255,.2);}
  .study-diagram .label{fill:var(--ink);font:500 14px var(--sans);}
  .study-diagram .label-blue{fill:var(--blue);font:500 14px var(--sans);}
  .study-diagram .small{fill:var(--muted);font:400 12px var(--sans);}
  .study-diagram .caption{fill:var(--muted);font:400 12px var(--sans);}
  .study-diagram .datum{stroke:var(--blue);stroke-width:2;}
  .study-diagram .axis{stroke:#77736e;stroke-width:2;}
  .study-diagram .load-point{fill:#79746d;}
  .study-diagram .cg-point{fill:var(--blue);}
  .study-diagram .runway{fill:#30302d;}
  .study-diagram .runway-mark{stroke:#fff;stroke-width:2;stroke-dasharray:16 12;}
  .study-diagram .route{stroke:var(--blue);stroke-width:2.4;stroke-dasharray:6 5;}
  .study-diagram figcaption{margin:12px 0 0;color:var(--muted);font-size:13px;line-height:1.55;}
  .study-diagram figcaption strong{color:var(--ink);font-weight:600;}
  @media(max-width:520px){.study-diagram{margin:22px -4px;padding:13px 10px 11px}.study-diagram .label,.study-diagram .label-blue{font-size:13px}.study-diagram .small{font-size:12px}.study-diagram figcaption{font-size:12px}}
  html[data-theme="dark"] .study-diagram .node{fill:var(--taupe);stroke:var(--line);}
  html[data-theme="dark"] .study-diagram .node-accent{fill:var(--blue-soft);stroke:rgba(4,71,255,.34);}
  html[data-theme="dark"] .study-diagram .label{fill:var(--ink);}
  html[data-theme="dark"] .study-diagram .label-blue{fill:#b7c4ff;}
  html[data-theme="dark"] .study-diagram .runway{fill:#575550;}
</style>
