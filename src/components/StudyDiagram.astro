    <text x="561" y="255" text-anchor="middle" class="label">Pista</text>
    <text x="126" y="244" class="small">Perfil conceptual · sin valores operativos</text>
  </svg>}

  {type === 'airfoil' && <svg viewBox="0 0 720 300" role="img" aria-labelledby={`diagram-title-airfoil-${uid} diagram-desc-airfoil-${uid}`}>
    <title id={`diagram-title-airfoil-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-airfoil-${uid}`}>Un perfil con la cuerda inclinada respecto de un viento relativo horizontal. Arriba hay menor presión y abajo mayor presión. A la derecha, una curva de coeficiente de sustentación que sube con el ángulo de ataque y cae después del máximo.</desc>
    <defs><marker id={`arrow-airfoil-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker></defs>
