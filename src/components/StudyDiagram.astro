    <path d="M50 220V232M102 220V232M188.7 220V232M362 220V232" class="ln thin" />
    <text x="470" y="214" text-anchor="end" class="ts">brazo (m)</text>
    <text x="50" y="252" text-anchor="middle" class="ts">0</text>
    <text x="102" y="252" text-anchor="middle" class="ts">0,20</text>
    <text x="189" y="252" text-anchor="middle" class="tb c-lift">0,53</text>
    <text x="362" y="252" text-anchor="middle" class="ts">1,20</text>
    <text x="40" y="290" class="t">400 kg × 0,20 m = 80 kg·m</text>
    <text x="40" y="314" class="t">200 kg × 1,20 m = 240 kg·m</text>
    <text x="40" y="338" class="t">Total: 600 kg y 320 kg·m</text>
    <text x="40" y="366" class="tb c-lift">CG = 320 ÷ 600 = 0,53 m</text>
  </svg>}

  {type === 'atmosphere' && <svg viewBox="0 0 480 336" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Gráfico de altura contra temperatura de la atmósfera estándar. Al nivel del mar hay 15 grados y 1013 hectopascales. La temperatura baja 6,5 grados cada 1000 metros: cerca de 5500 metros hay unos 21 grados bajo cero y 500 hectopascales, con la mitad del aire por debajo. En la tropopausa, cerca de 11 kilómetros, hay 56,5 grados bajo cero y unos 226 hectopascales.</desc>
    <text x="155" y="22" text-anchor="middle" class="tb c-weight">Temperatura</text>
    <text x="380" y="22" text-anchor="middle" class="tb">Presión</text>
    <line x1="60" y1="300" x2="60" y2="34" class="ln thin" />
    {[0, 3, 6, 9, 12].map((km) => <g><line x1="56" y1={isa.y(km)} x2="64" y2={isa.y(km)} class="ln thin" /><text x="50" y={isa.y(km) + 5} text-anchor="end" class="ts">{km === 0 ? '0' : `${km} km`}</text></g>)}
    <line x1="60" y1={isa.y(11)} x2="470" y2={isa.y(11)} class="guide" />
    <line x1={isa.x(-20.75)} y1={isa.y(5.5)} x2="284" y2={isa.y(5.5)} class="guide" />
