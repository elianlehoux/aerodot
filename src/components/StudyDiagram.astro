    <circle cx={isa.x(15)} cy={isa.y(0)} r="5" class="dot c-weight" />
    <circle cx={isa.x(-20.75)} cy={isa.y(5.5)} r="5" class="dot c-weight" />
    <circle cx={isa.x(-56.5)} cy={isa.y(11)} r="5" class="dot c-weight" />
    <text x="205" y="294" text-anchor="end" class="t c-weight">15 °C</text>
