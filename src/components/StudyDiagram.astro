  {type === 'imsafe' && <svg viewBox="0 0 720 220" role="img" aria-labelledby={`diagram-title-imsafe-${uid} diagram-desc-imsafe-${uid}`}>
    <title id={`diagram-title-imsafe-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-imsafe-${uid}`}>Seis casillas: enfermedad, medicación, estrés, alcohol, fatiga y emoción. Cada una pregunta por un factor que puede reducir atención o juicio.</desc>
