    --dg-plane:#3b3833;--dg-glass:#5d6b80;--dg-ground:#3f3b34;--dg-runway:#55524b;
    --dg-lift:#89a5ff;--dg-lift-soft:rgba(137,165,255,.16);
    --dg-weight:#ff8d61;--dg-weight-soft:rgba(255,141,97,.13);
