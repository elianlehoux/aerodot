const riskCells = [3, 2, 1].flatMap((p, row) => [1, 2, 3].map((g, col) => {
  const s = p + g;
  const level = s >= 5 ? 'no' : s === 4 ? 'mid' : 'ok';
  return { x: 128 + col * 112, y: 20 + row * 70, level, text: level === 'no' ? 'No salgo' : level === 'mid' ? 'Mitigá' : 'Seguí' };
}));
const imsafeCards = [
  ['I', 'Enfermedad', '¿Me siento bien?'],
