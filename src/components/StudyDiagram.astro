---
const { type, reportWhere, reportRef, instance } = Astro.props;
// Un diagrama puede repetirse dentro del mismo capitulo (p. ej. carb-ice x4 en motopropulsor).
// Los ids se derivan de la instancia, no solo del tipo, para que titulo, descripcion,
// pie y marcadores SVG sean unicos en la pagina.
const uid = instance;
const captions = {
  forces: 'Esquema conceptual de fuerzas en vuelo recto y nivelado, sin aceleración. En otras maniobras el balance y la orientación cambian.',
  'turn-load': 'Viraje coordinado y nivelado idealizado: la sustentación se inclina y su componente vertical sostiene el peso.',
  'pitot-static': 'Relación funcional simplificada entre pitot, toma estática e instrumentos. La instalación real depende del avión.',
  'weight-balance': 'Ejemplo aritmético ilustrativo de datum, brazos, cargas y centro de gravedad; no son datos de una aeronave.',
  'wind-triangle': 'Suma vectorial conceptual: velocidad verdadera más viento (movimiento de la masa de aire hacia donde sopla) da la velocidad respecto del suelo.',
  'traffic-pattern': 'Circuito ilustrativo: las flechas muestran la trayectoria de la aeronave, no la dirección meteorológica del viento. Lado, altura, entrada y comunicaciones se confirman para cada aeródromo.',
  'decision-loop': 'Ciclo didáctico para observar, evaluar, elegir, actuar y revisar una decisión.',
  'electrical-system': 'Diagrama conceptual de fuentes, barra eléctrica y cargas; la arquitectura real varía entre aeronaves.',
  'fuel-system': 'Recorrido funcional genérico del combustible; bombas, selectores y componentes dependen de la aeronave.',
  flightpath: 'Actitud, trayectoria y ángulo de ataque son magnitudes relacionadas pero distintas; esquema lateral sin escala.',
  'landing-approach': 'Vista lateral conceptual de una aeronave en descenso hacia una pista; no prescribe senda, altura, velocidad ni punto de toma.',
  airfoil: 'Perfil simplificado: el ángulo de ataque se mide entre la cuerda y el viento relativo. La curva de la derecha muestra la forma típica del coeficiente de sustentación, no un ángulo para copiar.',
  'carb-ice': 'En el venturi bajan la presión y la temperatura, y la vaporización del combustible enfría más. El hielo puede formarse aunque el aire exterior esté sobre 0 °C.',
  atmosphere: 'Modelo ISA de estudio: 15 °C y 1013,25 hPa al nivel del mar, y unos 6,5 °C menos cada 1000 m en la troposfera. No es el estado de la atmósfera de un día real.',
  front: 'Corte idealizado de un frente frío. El aire frío avanza como una cuña y obliga al aire más cálido a ascender. La nubosidad y la hora reales salen del pronóstico.',
  'density-altitude': 'La altitud de densidad corrige la altitud de presión por la temperatura. Más calor que la estándar equivale, para la performance, a estar más alto.',
  'vx-vy': 'Vx gana más altura por distancia recorrida. Vy gana más altura por minuto, pero más lejos. Los valores numéricos están en el manual del avión.',
  'right-of-way': 'Sección 91.113 de la RAAC Parte 91: convergencia, aproximación de frente y alcance. En el aeródromo se suman las cesiones de la Sección 91.128. Ver y evitar sigue en pie.',
  axes: 'Los tres ejes pasan por el centro de gravedad. Cada uno nombra un giro y, en forma principal, un mando. Los movimientos reales se combinan.',
  imsafe: 'Seis preguntas de autoevaluación antes de volar. No es una norma argentina ni un certificado médico: si hay duda, la decisión se toma en tierra.',
  'hypoxia-types': 'Cuatro caminos distintos hacia la falta de oxígeno en los tejidos. La altitud es solo uno de ellos.',
  priority: 'Orden de entrenamiento ante una anormalidad: primero el control de la aeronave, después una trayectoria alcanzable y entonces la comunicación.',
  metar: 'Ejemplo armado para leer el orden de un METAR. No es una observación emitida por el SMN ni una condición para volar.',
  'cg-stability': 'En un avión de cola convencional, la cola suele producir una fuerza hacia abajo para equilibrar el momento. Adelantar o atrasar el CG cambia cuánta fuerza hace falta y cómo responde el avión.',
  stability: 'Tres respuestas de una parcela de aire que sube y se enfría. El dibujo compara la parcela con el aire que la rodea. No es el perfil de temperatura de un día real.',
  papi: 'PAPI de cuatro luces en la instalación más habitual: dos blancas y dos rojas indican la senda publicada. Más blanco es alto. Más rojo es bajo.',
  'ground-reference': 'Curso rectangular visto desde arriba. Con viento desde la izquierda, el viraje a favor del viento pide más inclinación para que la trayectoria sobre el suelo siga el rectángulo.',
  'risk-matrix': 'Dos preguntas juntas: qué tan probable y qué tan grave. La esquina de alta probabilidad y alta gravedad es la que se resuelve en tierra.',
};
const title = {
  forces: 'Cuatro fuerzas principales sobre el avión',
  'turn-load': 'Componentes de la sustentación en un viraje',
  'pitot-static': 'Esquema pitot-estático',
  'weight-balance': 'Datum, brazos y centro de gravedad',
  'wind-triangle': 'Triángulo de velocidades',
  'traffic-pattern': 'Secuencia ilustrativa de un circuito de tránsito',
  'decision-loop': 'Ciclo de toma de decisiones',
  'electrical-system': 'Fuentes y cargas eléctricas',
  'fuel-system': 'Recorrido conceptual del combustible',
  flightpath: 'Actitud, trayectoria y ángulo de ataque',
  'landing-approach': 'Trayectoria conceptual de aproximación visual',
  airfoil: 'Ángulo de ataque y curva de sustentación',
  'carb-ice': 'Por qué el carburador puede formar hielo',
  atmosphere: 'Atmósfera estándar, en corte',
  front: 'Corte de un frente frío',
  'density-altitude': 'De la presión a la altitud de densidad',
  'vx-vy': 'Mejor ángulo y mejor régimen',
  'right-of-way': 'Tres geometrías de prioridad',
  axes: 'Ejes y giros del avión',
  imsafe: 'Chequeo IMSAFE',
  'hypoxia-types': 'Cuatro tipos de hipoxia',
  priority: 'Orden de atención en una emergencia',
  metar: 'Cómo se lee un METAR',
  'cg-stability': 'Centro de gravedad y equilibrio longitudinal',
  stability: 'Estable, neutro e inestable',
  papi: 'Luces del PAPI en la senda',
  'ground-reference': 'Curso rectangular y viento',
  'risk-matrix': 'Probabilidad y gravedad',
};
const caption = captions[type];
const diagramTitle = title[type];
---

{caption && <figure class="study-diagram" data-report-target data-report-excerpt={`${diagramTitle}. ${caption}`} data-report-where={reportWhere} data-report-ref={reportRef} aria-labelledby={`diagram-caption-${uid}`}>
  {type === 'forces' && <svg viewBox="0 0 620 280" role="img" aria-labelledby={`diagram-title-forces-${uid} diagram-desc-forces-${uid}`}>
    <title id={`diagram-title-forces-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-forces-${uid}`}>Sustentación hacia arriba, peso hacia abajo, tracción hacia adelante y resistencia hacia atrás alrededor de una aeronave simplificada.</desc>
    <defs><marker id={`arrow-forces-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker></defs>
    <path d="M235 143H393L430 150L393 157H235L196 175L184 169L211 150L184 131L196 125Z" class="aircraft" />
    <path d="M293 143L332 105L347 106L332 149M293 157L332 194L347 193L332 151" class="aircraft" />
    <line x1="309" y1="133" x2="309" y2="54" class="force force-blue" marker-end="url(#arrow-forces-${uid})" />
    <line x1="309" y1="166" x2="309" y2="231" class="force force-muted" marker-end="url(#arrow-forces-${uid})" />
    <line x1="420" y1="151" x2="530" y2="151" class="force force-blue" marker-end="url(#arrow-forces-${uid})" />
    <line x1="197" y1="151" x2="86" y2="151" class="force force-muted" marker-end="url(#arrow-forces-${uid})" />
    <text x="309" y="39" text-anchor="middle" class="label label-blue">Sustentación</text>
    <text x="309" y="252" text-anchor="middle" class="label">Peso</text>
    <text x="526" y="137" text-anchor="end" class="label label-blue">Tracción</text>
    <text x="91" y="137" class="label">Resistencia</text>
    <text x="310" y="275" text-anchor="middle" class="small">Vectores ilustrativos; no están dibujados a escala.</text>
  </svg>}

  {type === 'turn-load' && <svg viewBox="0 0 620 270" role="img" aria-labelledby={`diagram-title-turn-${uid} diagram-desc-turn-${uid}`}>
    <title id={`diagram-title-turn-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-turn-${uid}`}>Desde el centro de gravedad, el peso apunta hacia abajo. La sustentación en un viraje se inclina respecto de la vertical; su componente vertical equilibra el peso.</desc>
    <defs><marker id={`arrow-turn-${uid}`} markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0 0L10 5L0 10Z" fill="currentColor" /></marker></defs>
    <line x1="300" y1="68" x2="300" y2="216" class="guide" />
    <line x1="300" y1="142" x2="300" y2="217" class="force force-muted" marker-end="url(#arrow-turn-${uid})" />
    <line x1="300" y1="142" x2="300" y2="68" class="force force-muted" stroke-dasharray="5 6" marker-end="url(#arrow-turn-${uid})" />
    <line x1="300" y1="142" x2="430" y2="67" class="force force-blue" marker-end="url(#arrow-turn-${uid})" />
    <path d="M300 93 A49 49 0 0 1 342 117" class="angle" />
    <circle cx="300" cy="142" r="5" class="center" />
    <text x="313" y="205" class="label">Peso (W)</text>
    <text x="314" y="80" class="label">Componente vertical</text>
    <text x="431" y="61" class="label label-blue">Sustentación (L)</text>
    <text x="346" y="103" class="label label-blue">φ</text>
    <text x="300" y="250" text-anchor="middle" class="caption">En vuelo nivelado idealizado: L · cos(φ) = W</text>
  </svg>}

  {type === 'pitot-static' && <svg viewBox="0 0 720 300" role="img" aria-labelledby={`diagram-title-pitot-${uid} diagram-desc-pitot-${uid}`}>
    <title id={`diagram-title-pitot-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-pitot-${uid}`}>El tubo pitot lleva presión total al velocímetro. La presión estática alimenta velocímetro, altímetro y variómetro.</desc>
    <defs>
      <marker id={`arrow-pitot-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker>
    </defs>
    <rect x="35" y="36" width="164" height="70" rx="8" class="node" />
    <text x="117" y="65" text-anchor="middle" class="label">Pitot</text>
    <text x="117" y="86" text-anchor="middle" class="small">presión total</text>
    <rect x="35" y="194" width="164" height="70" rx="8" class="node" />
    <text x="117" y="223" text-anchor="middle" class="label">Toma estática</text>
    <text x="117" y="244" text-anchor="middle" class="small">presión estática</text>
    <rect x="285" y="86" width="177" height="112" rx="8" class="node node-accent" />
    <text x="373" y="126" text-anchor="middle" class="label">Velocímetro</text>
    <text x="373" y="151" text-anchor="middle" class="small">pitot + estática</text>
    <text x="373" y="172" text-anchor="middle" class="small">presión dinámica</text>
    <rect x="535" y="38" width="150" height="74" rx="8" class="node" />
    <text x="610" y="69" text-anchor="middle" class="label">Altímetro</text>
    <text x="610" y="91" text-anchor="middle" class="small">presión estática</text>
    <rect x="535" y="190" width="150" height="74" rx="8" class="node" />
    <text x="610" y="221" text-anchor="middle" class="label">Variómetro</text>
    <text x="610" y="243" text-anchor="middle" class="small">cambio de estática</text>
    <path d="M199 70H242V113H285" class="pipe pipe-blue" marker-end="url(#arrow-pitot-${uid})" />
    <path d="M199 229H242V171H285" class="pipe" marker-end="url(#arrow-pitot-${uid})" />
    <path d="M199 229H500V75H535" class="pipe" marker-end="url(#arrow-pitot-${uid})" />
    <path d="M199 229H500V227H535" class="pipe" marker-end="url(#arrow-pitot-${uid})" />
  </svg>}

  {type === 'weight-balance' && <svg viewBox="0 0 720 245" role="img" aria-labelledby={`diagram-title-balance-${uid} diagram-desc-balance-${uid}`}>
    <title id={`diagram-title-balance-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-balance-${uid}`}>Una línea de referencia marca el datum. Las distancias desde el datum son brazos; el centro de gravedad resulta de peso total y momento total. El signo del brazo y del momento depende de la convención de datum del fabricante.</desc>
    <defs><marker id={`arrow-balance-${uid}`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="currentColor" /></marker></defs>
    <line x1="80" y1="161" x2="655" y2="161" class="axis" />
    <line x1="98" y1="75" x2="98" y2="185" class="datum" />
    <text x="98" y="57" text-anchor="middle" class="label">Datum</text>
    <circle cx="148" cy="161" r="8" class="load-point" />
    <line x1="148" y1="93" x2="148" y2="161" class="guide" />
    <text x="148" y="78" text-anchor="middle" class="label">A · 400 kg · 0,20 m</text>
    <circle cx="398" cy="161" r="8" class="load-point" />
    <line x1="398" y1="93" x2="398" y2="161" class="guide" />
    <text x="398" y="78" text-anchor="middle" class="label">B · 200 kg · 1,20 m</text>
    <circle cx="231" cy="161" r="9" class="cg-point" />
    <text x="231" y="204" text-anchor="middle" class="label label-blue">CG · 0,53 m</text>
    <line x1="98" y1="218" x2="231" y2="218" class="arm" marker-end="url(#arrow-balance-${uid})" />
    <text x="166" y="239" text-anchor="middle" class="small">Brazo desde el datum</text>
    <text x="545" y="239" text-anchor="middle" class="small">Signo según la convención del datum</text>
  </svg>}

  {type === 'wind-triangle' && <svg viewBox="0 0 620 290" role="img" aria-labelledby={`diagram-title-wind-${uid} diagram-desc-wind-${uid}`}>
    <title id={`diagram-title-wind-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-wind-${uid}`}>Vector de velocidad verdadera desde el origen, vector viento desde su punta y vector resultante de velocidad respecto del suelo.</desc>
    <defs><marker id={`arrow-wind-blue-${uid}`} markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0 0L10 5L0 10Z" fill="currentColor" /></marker></defs>
    <line x1="98" y1="215" x2="365" y2="215" class="guide" />
    <line x1="110" y1="215" x2="330" y2="96" class="vector vector-blue" marker-end="url(#arrow-wind-blue-${uid})" />
    <line x1="330" y1="96" x2="482" y2="171" class="vector vector-muted" marker-end="url(#arrow-wind-blue-${uid})" />
    <line x1="110" y1="215" x2="482" y2="171" class="vector vector-dark" marker-end="url(#arrow-wind-blue-${uid})" />
    <circle cx="110" cy="215" r="4" class="center" />
    <circle cx="330" cy="96" r="4" class="center" />
    <circle cx="482" cy="171" r="4" class="center" />
    <text x="194" y="139" class="label label-blue">TAS</text>
    <text x="389" y="103" class="label">Viento</text>
    <text x="389" y="122" class="small">masa de aire · hacia donde sopla</text>
    <text x="278" y="219" class="label">GS / derrota</text>
    <text x="310" y="266" text-anchor="middle" class="caption">V⃗GS = V⃗TAS + V⃗viento</text>
  </svg>}

  {type === 'traffic-pattern' && <svg viewBox="0 0 720 280" role="img" aria-labelledby={`diagram-title-pattern-${uid} diagram-desc-pattern-${uid}`}>
    <title id={`diagram-title-pattern-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-pattern-${uid}`}>Diagrama rectangular conceptual con tramo de salida o viento en cara, viento cruzado, viento en cola, básica y final. Las flechas son trayectorias de la aeronave, no la dirección del viento meteorológico.</desc>
    <defs><marker id={`arrow-pattern-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker></defs>
    <rect x="86" y="183" width="520" height="31" rx="3" class="runway" />
    <line x1="101" y1="199" x2="591" y2="199" class="runway-mark" />
    <path d="M150 180H480" class="route" marker-end="url(#arrow-pattern-${uid})" />
    <path d="M490 171V118" class="route" marker-end="url(#arrow-pattern-${uid})" />
    <path d="M478 106H117" class="route" marker-end="url(#arrow-pattern-${uid})" />
    <path d="M108 115V175Q95 191 81 199" class="route" />
    <path d="M31 199H78" class="route" marker-end="url(#arrow-pattern-${uid})" />
    <text x="325" y="168" text-anchor="middle" class="label">Salida · viento en cara</text>
    <text x="500" y="148" class="label">Cruzado</text>
    <text x="310" y="89" text-anchor="middle" class="label">Viento en cola</text>
    <text x="59" y="153" class="label">Básica</text>
    <text x="44" y="223" class="label label-blue">Final</text>
    <text x="598" y="237" class="small">Pista</text>
  </svg>}

  {type === 'decision-loop' && <svg viewBox="0 0 720 235" role="img" aria-labelledby={`diagram-title-decision-${uid} diagram-desc-decision-${uid}`}>
    <title id={`diagram-title-decision-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-decision-${uid}`}>Cinco pasos conectados: observar, evaluar, elegir, actuar y revisar; la revisión inicia una nueva observación.</desc>
    <defs><marker id={`arrow-decision-${uid}`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="currentColor" /></marker></defs>
    <rect x="24" y="72" width="116" height="60" rx="7" class="node" />
    <rect x="166" y="72" width="116" height="60" rx="7" class="node" />
    <rect x="308" y="72" width="116" height="60" rx="7" class="node node-accent" />
    <rect x="450" y="72" width="116" height="60" rx="7" class="node" />
    <rect x="592" y="72" width="104" height="60" rx="7" class="node" />
    <text x="82" y="107" text-anchor="middle" class="label">Observar</text>
    <text x="224" y="107" text-anchor="middle" class="label">Evaluar</text>
    <text x="366" y="107" text-anchor="middle" class="label label-blue">Elegir</text>
    <text x="508" y="107" text-anchor="middle" class="label">Actuar</text>
    <text x="644" y="107" text-anchor="middle" class="label">Revisar</text>
    <path d="M140 102H161M282 102H303M424 102H445M566 102H587" class="pipe" marker-end="url(#arrow-decision-${uid})" />
    <path d="M644 139V183H82V139" class="pipe pipe-blue" marker-end="url(#arrow-decision-${uid})" />
    <text x="363" y="215" text-anchor="middle" class="small">Volvé a observar cuando cambie la situación o después de actuar.</text>
  </svg>}

  {type === 'electrical-system' && <svg viewBox="0 0 760 270" role="img" aria-labelledby={`diagram-title-electrical-${uid} diagram-desc-electrical-${uid}`}>
    <title id={`diagram-title-electrical-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-electrical-${uid}`}>La batería y el alternador se conectan, a través de protecciones y controles que varían según el avión, con una barra que alimenta instrumentos, luces y comunicaciones.</desc>
    <defs><marker id={`arrow-electrical-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker></defs>
    <rect x="28" y="35" width="166" height="68" rx="8" class="node" />
    <text x="111" y="65" text-anchor="middle" class="label">Batería</text>
    <text x="111" y="86" text-anchor="middle" class="small">energía almacenada</text>
    <rect x="28" y="166" width="166" height="68" rx="8" class="node" />
    <text x="111" y="196" text-anchor="middle" class="label">Alternador</text>
    <text x="111" y="217" text-anchor="middle" class="small">con motor en marcha*</text>
    <rect x="274" y="94" width="190" height="82" rx="8" class="node node-accent" />
    <text x="369" y="127" text-anchor="middle" class="label label-blue">Barra eléctrica</text>
    <text x="369" y="150" text-anchor="middle" class="small">protecciones / mandos*</text>
    <rect x="548" y="25" width="180" height="58" rx="8" class="node" />
    <rect x="548" y="106" width="180" height="58" rx="8" class="node" />
    <rect x="548" y="187" width="180" height="58" rx="8" class="node" />
    <text x="638" y="60" text-anchor="middle" class="label">Instrumentos</text>
    <text x="638" y="141" text-anchor="middle" class="label">Comunicaciones</text>
    <text x="638" y="222" text-anchor="middle" class="label">Luces y otros equipos</text>
    <path d="M194 69H233V119H274" class="pipe" marker-end="url(#arrow-electrical-${uid})" />
    <path d="M194 200H233V151H274" class="pipe pipe-blue" marker-end="url(#arrow-electrical-${uid})" />
    <path d="M464 113H508V54H548" class="pipe" marker-end="url(#arrow-electrical-${uid})" />
    <path d="M464 135H548" class="pipe" marker-end="url(#arrow-electrical-${uid})" />
    <path d="M464 157H508V216H548" class="pipe" marker-end="url(#arrow-electrical-${uid})" />
    <text x="379" y="264" text-anchor="middle" class="small">* Componentes, redundancia y lógica de carga dependen del diseño.</text>
  </svg>}

  {type === 'fuel-system' && <svg viewBox="0 0 760 250" role="img" aria-labelledby={`diagram-title-fuel-${uid} diagram-desc-fuel-${uid}`}>
    <title id={`diagram-title-fuel-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-fuel-${uid}`}>Flujo conceptual desde depósitos hacia selector, filtrado y alimentación, dosificación y motor. La instalación puede variar y no todos los aviones tienen los mismos componentes.</desc>
    <defs><marker id={`arrow-fuel-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker></defs>
    <rect x="20" y="77" width="140" height="78" rx="8" class="node" />
    <text x="90" y="109" text-anchor="middle" class="label">Depósitos</text>
    <text x="90" y="132" text-anchor="middle" class="small">cantidad / calidad</text>
    <rect x="195" y="77" width="140" height="78" rx="8" class="node" />
    <text x="265" y="109" text-anchor="middle" class="label">Selector</text>
