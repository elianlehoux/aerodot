    <rect x="250" y="114" width="220" height="70" rx="8" class="node node-accent" /><text x="360" y="144" text-anchor="middle" class="label label-blue">F · Fatiga</text><text x="360" y="164" text-anchor="middle" class="small">¿dormí lo necesario?</text>
    <rect x="484" y="114" width="220" height="70" rx="8" class="node" /><text x="594" y="144" text-anchor="middle" class="label">E · Emoción</text><text x="594" y="164" text-anchor="middle" class="small">¿ocupa mi cabeza?</text>
  </svg>}

  {type === 'hypoxia-types' && <svg viewBox="0 0 720 230" role="img" aria-labelledby={`diagram-title-hypoxia-${uid} diagram-desc-hypoxia-${uid}`}>
