    <text x="398" y="38" text-anchor="middle" class="tb c-weight">Inestable</text>
    <text x="82" y="66" text-anchor="middle" class="ts">aire: 12°</text>
    <text x="240" y="66" text-anchor="middle" class="ts">aire: 10°</text>
    <text x="398" y="66" text-anchor="middle" class="ts">aire: 8°</text>
    <circle cx="82" cy="148" r="27" class="parcel cold" /><text x="82" y="154" text-anchor="middle" class="tb">10°</text>
