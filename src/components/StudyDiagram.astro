    <text x="153" y="150" text-anchor="middle" class="tb c-thrust">030°</text>
    <text x="198" y="229" text-anchor="middle" class="tb c-lift">060°</text>
    <text x="252" y="152" text-anchor="middle" class="tb c-weight halo">090°</text>
    <circle cx="410" cy={adf.p[1]} r="17" class="ndb c-weight" />
    <circle cx="410" cy={adf.p[1]} r="10" class="ndb c-weight" />
    <circle cx="410" cy={adf.p[1]} r="4" class="dot c-weight" />
    <text x="410" y="308" text-anchor="middle" class="tb c-weight">NDB</text>
    <circle cx={adf.dial[0]} cy={adf.dial[1]} r="54" class="cdi" />
    {adf.ticks.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} class="ln thin" />)}
    <text x={adf.dial[0]} y={adf.dial[1] - 22} text-anchor="middle" class="ts">0</text>
    <path d={arrow(adf.tail[0], adf.tail[1], adf.needle[0], adf.needle[1], 11)} class="arw c-lift" />
    <circle cx={adf.dial[0]} cy={adf.dial[1]} r="4.5" class="dot c-ink" />
    <text x={adf.dial[0]} y="194" text-anchor="middle" class="ts">Aguja del ADF</text>
    <text x={adf.dial[0]} y="216" text-anchor="middle" class="ts c-lift">060° desde la nariz</text>
    <line x1="10" y1="330" x2="470" y2="330" class="sep" />
    <text x="240" y="362" text-anchor="middle" class="tb"><tspan class="c-thrust">030°</tspan> + <tspan class="c-lift">060°</tspan> = <tspan class="c-weight">090°</tspan></text>
    <text x="240" y="388" text-anchor="middle" class="ts"><tspan class="c-thrust">rumbo</tspan> + <tspan class="c-lift">relativa</tspan> = <tspan class="c-weight">marcación a la estación</tspan></text>
  </svg>}

  {type === 'altimeter-transition' && <svg viewBox="0 0 480 468" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Corte de costado de un vuelo que despega, asciende, cruza en nivel de vuelo y desciende a otro aeródromo. Abajo, el altímetro va en QNH e indica altitud sobre el nivel del mar. Arriba, va en 1013,25 hectopascales e indica niveles de vuelo. Entre la altitud de transición, más baja, y el nivel de transición, más alto, queda la capa de transición. Al subir, se cambia a 1013,25 al pasar la altitud de transición. Al bajar, se vuelve a QNH al pasar el nivel de transición.</desc>
    <rect x="10" y="150" width="460" height="50" class="band" />
    <line x1="10" y1="150" x2="470" y2="150" class="ln dash c-drag" />
    <line x1="10" y1="200" x2="470" y2="200" class="ln dash c-drag" />
    <text x="240" y="142" text-anchor="middle" class="tb c-drag">Nivel de transición</text>
    <text x="240" y="181" text-anchor="middle" class="ts">capa de transición</text>
    <text x="240" y="224" text-anchor="middle" class="tb c-drag">Altitud de transición</text>
    <text x="240" y="88" text-anchor="middle" class="tb">1013,25 hPa</text>
    <text x="240" y="112" text-anchor="middle" class="ts">niveles de vuelo (FL)</text>
    <text x="240" y="264" text-anchor="middle" class="tb">QNH</text>
    <text x="240" y="288" text-anchor="middle" class="ts">altitud sobre el nivel del mar</text>
    <rect x="10" y="330" width="460" height="12" class="ground" />
    <rect x="20" y="325" width="70" height="6" rx="2" class="runway" />
    <rect x="390" y="325" width="70" height="6" rx="2" class="runway" />
    <path d="M78 327L146 65Q150 50 166 50H314Q330 50 334 65L402 327" class="ln thick c-lift" />
    <path d={arrow(92.4, 271.6, 97.4, 252.2, 12)} class="arw c-lift" />
    <path d={arrow(382.6, 252.2, 387.6, 271.6, 12)} class="arw c-lift" />
    <g transform="translate(240 50) scale(.32)"><path d={SIDE} class="pl" /><path d={SIDE_WIN} class="pl-win" /></g>
    <circle cx="111" cy="200" r="5" class="dot c-lift" />
    <circle cx="356" cy="150" r="5" class="dot c-lift" />
    <circle cx="88" cy="200" r="11" class="badge" /><text x="88" y="205" text-anchor="middle" class="badge-t">1</text>
    <circle cx="379" cy="150" r="11" class="badge" /><text x="379" y="155" text-anchor="middle" class="badge-t">2</text>
    <circle cx="28" cy="372" r="11" class="badge" /><text x="28" y="377" text-anchor="middle" class="badge-t">1</text>
    <text x="46" y="378" class="tb">Al subir: 1013,25 hPa</text>
    <text x="46" y="402" class="ts">al pasar la altitud de transición</text>
    <circle cx="28" cy="428" r="11" class="badge" /><text x="28" y="433" text-anchor="middle" class="badge-t">2</text>
    <text x="46" y="434" class="tb">Al bajar: QNH</text>
    <text x="46" y="458" class="ts">al pasar el nivel de transición</text>
  </svg>}

  {type === 'airspeed-arcs' && <svg viewBox="0 0 480 462" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Un velocímetro con sus marcas de color. Un arco blanco interior va de VS0 a VFE: el rango para usar flaps. Un arco verde va de VS1 a VNO: la operación normal. Un arco amarillo va de VNO a VNE: precaución, solo con aire calmo. Una línea roja marca VNE, la velocidad que nunca se debe superar.</desc>
    <circle cx={asi.cx} cy={asi.cy} r="126" class="asi-face" />
    <path d={asi.ticks} class="asi-tick" />
    <path d={asi.white} class="asi-arc asi-white thin" />
    <path d={asi.green} class="asi-arc asi-green" />
    <path d={asi.yellow} class="asi-arc asi-yellow" />
    <line x1={asi.red[0]} y1={asi.red[1]} x2={asi.red[2]} y2={asi.red[3]} class="asi-redline" />
    <text x={asi.cx} y={asi.cy - 34} text-anchor="middle" class="asi-label">KT</text>
    <line x1={asi.cx} y1={asi.cy} x2={asi.needle[0]} y2={asi.needle[1]} class="asi-needle" />
    <circle cx={asi.cx} cy={asi.cy} r="9" class="asi-hub" />
    {asiLegend.map((item) => <g>
      <line x1={item.x} y1={item.y - 5} x2={item.x + 26} y2={item.y - 5} class="swatch-o" />
      <line x1={item.x} y1={item.y - 5} x2={item.x + 26} y2={item.y - 5} class={`swatch ${item.cls}`} />
      <text x={item.x + 40} y={item.y} class="tb">{item.title}</text>
      <text x={item.x + 40} y={item.y + 24} class="ts">{item.lines[0]}</text>
      <text x={item.x + 40} y={item.y + 46} class="ts">{item.lines[1]}</text>
    </g>)}
  </svg>}

  {type === 'adverse-yaw' && <svg viewBox="0 0 480 436" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>El avión visto desde arriba, dos veces, al empezar un viraje a la derecha. Arriba, solo con alerones: el alerón izquierdo baja y el derecho sube. El ala izquierda gana sustentación pero también más resistencia, frena, y la nariz se va hacia la izquierda, al revés del viraje. Abajo, con timón a la derecha: la nariz acompaña el viraje y la bola queda centrada.</desc>
    <rect x="6" y="4" width="468" height="208" rx="14" class="panel" />
    <rect x="6" y="224" width="468" height="208" rx="14" class="panel" />
    {[0, 220].map((dy) => <g>
      <path d={arrow(63, 110 + dy, 63, 170 + dy, 11)} class="arw thick c-drag" />
      <path d={arrow(197, 110 + dy, 197, 134 + dy, 9)} class="arw c-drag" />
      <g transform={`translate(130 ${104 + dy}) scale(1.5)`}><path d={TOP} class="pl" /></g>
      <line x1="50" y1={104.5 + dy} x2="76" y2={104.5 + dy} class="ln thick c-weight" />
      <line x1="184" y1={104.5 + dy} x2="210" y2={104.5 + dy} class="ln thick c-ink" />
      <text x="63" y={74 + dy} text-anchor="middle" class="ts">alerón ↓</text>
      <text x="197" y={74 + dy} text-anchor="middle" class="ts">alerón ↑</text>
      <text x="16" y={196 + dy} class="ts c-drag">más resistencia</text>
    </g>)}
    {qArrowParts(130, 32, 154, 18, 178, 38).map((part, k) => <path d={part} class={k ? 'arw c-ink' : 'arw nofill c-ink dash'} />)}
    <text x="186" y="38" class="ts">viraje</text>
    <path d={qArrow(130, 32, 106, 18, 82, 38, 11)} class="arw c-weight" />
    <text x="74" y="38" text-anchor="end" class="ts c-weight">nariz</text>
    <text x="250" y="44" class="tb">1 · Solo alerones</text>
    <text x="250" y="72" class="ts">Alabeás a la derecha.</text>
    <text x="250" y="96" class="ts">El alerón que baja</text>
    <text x="250" y="120" class="ts">frena más esa ala.</text>
    <text x="250" y="156" class="tb c-weight">La nariz se va</text>
    <text x="250" y="180" class="tb c-weight">a la izquierda</text>
    <line x1="130" y1="382" x2="139" y2="398" class="ln thick c-thrust" />
    <text x="166" y="398" class="ts c-thrust">timón</text>
    <path d={qArrow(130, 252, 154, 238, 178, 258, 11)} class="arw c-thrust" />
    <text x="186" y="258" class="ts c-thrust">nariz</text>
    <text x="250" y="264" class="tb">2 · Con timón</text>
    <text x="250" y="292" class="ts">Timón a la derecha:</text>
    <text x="250" y="316" class="ts">corrige la guiñada.</text>
    <text x="250" y="352" class="tb c-thrust">La nariz acompaña</text>
    <text x="250" y="376" class="tb c-thrust">el viraje</text>
    <text x="250" y="404" class="ts">bola centrada</text>
  </svg>}

  {type === 'slip-skid' && <svg viewBox="0 0 480 352" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Tres columnas para un viraje a la derecha. Arriba, el avión visto desde arriba sobre su trayectoria curva; abajo, la bola del inclinómetro. Resbale: la nariz apunta hacia afuera de la curva, gira de menos, y la bola cae hacia adentro del viraje. Coordinado: la nariz sigue la trayectoria y la bola queda centrada. Derrape: la nariz apunta hacia adentro de la curva, gira de más, y la bola se va hacia afuera.</desc>
    <text x="16" y="20" class="ts">Viraje a la derecha</text>
    {slipCols.map((col) => <g>
      <rect x={col.cx - 72} y="32" width="144" height="312" rx="14" class="panel" />
      <text x={col.cx} y="60" text-anchor="middle" class={`tb ${col.cls}`}>{col.title}</text>
      <path d={arcArrow(col.cx + 64, 140, 64, 64, 140, 222, 10)} class="arw thin c-lift" />
      <g transform={`translate(${col.cx} 140) rotate(${col.yaw}) scale(.5)`}><path d={TOP} class="pl" /></g>
      <path d={arc(col.cx, 196, 56, 58, 122)} class="tube-o" />
      <path d={arc(col.cx, 196, 56, 58, 122)} class="tube-i" />
      <path d={`M${col.cx - 11} 241V261M${col.cx + 11} 241V261`} class="ln thin c-ink" />
      <circle cx={col.ballX} cy={col.ballY} r="8" class={`dot ${col.cls}`} />
      <text x={col.cx} y="296" text-anchor="middle" class="t">{col.ballNote}</text>
      <text x={col.cx} y="320" text-anchor="middle" class="ts">{col.noseNote}</text>
    </g>)}
  </svg>}

  <figcaption id={`diagram-caption-${uid}`}><strong>{diagramTitle}.</strong>{` ${caption}`}</figcaption>
</figure>}

<style>
