    --dg-line:#d8d2ca;--dg-guide:#9d968c;
    --dg-plane:#ffffff;--dg-glass:#c8d5ea;--dg-ground:#e4ddd0;--dg-runway:#3a3936;
    --dg-lift:#0447ff;--dg-lift-soft:rgba(4,71,255,.08);
    --dg-weight:#d1430c;--dg-weight-soft:rgba(209,67,12,.08);
    --dg-thrust:#0b8048;--dg-thrust-soft:rgba(11,128,72,.09);
    --dg-drag:#986a00;--dg-drag-soft:rgba(152,106,0,.11);
    --dg-air:#08798a;--dg-air-soft:rgba(8,121,138,.08);
