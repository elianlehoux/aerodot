    <text x="270" y="116" class="t c-weight">≈ 3000 ft</text>
    <text x="270" y="208" class="tb">Altitud de presión</text>
    <text x="270" y="230" class="t">1000 ft</text>
    <text x="285" y="278" text-anchor="middle" class="t on-ground">Más carrera, menos ascenso</text>
