    <rect x="16" y="48" width="52" height="46" rx="6" class="seg-fuel c-ink" />
    <rect x="72" y="48" width="226" height="46" rx="6" class="seg-fuel c-lift" />
    <rect x="302" y="48" width="74" height="46" rx="6" class="seg-fuel dashed c-drag" />
    <rect x="380" y="48" width="84" height="46" rx="6" class="seg-fuel strong c-weight" />
    <text x="42" y="120" text-anchor="middle" class="ts">rodaje</text>
    <text x="185" y="120" text-anchor="middle" class="t c-lift">viaje</text>
    <text x="339" y="120" text-anchor="middle" class="ts">alternativa</text>
    <text x="339" y="140" text-anchor="middle" class="ts">si corresponde</text>
    <text x="464" y="28" text-anchor="end" class="tb c-weight">reserva final</text>
    <path d="M380 156H464" class="ln c-weight" />
    <text x="464" y="180" text-anchor="end" class="t">queda al llegar</text>
    <text x="464" y="202" text-anchor="end" class="ts">VFR: 30 min de día, 45 de noche</text>
  </svg>}

  {type === 'civil-twilight' && <svg viewBox="0 0 480 270" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>El sol baja a lo largo de la tarde. Primero está sobre el horizonte: es de día. Al cruzar el horizonte se pone, pero todavía no es de noche: empieza el crepúsculo civil. Cuando el centro del sol llega a 6 grados por debajo del horizonte termina el crepúsculo civil y empieza la noche.</desc>
    <rect x="20" y="40" width="180" height="200" class="zone c-drag" />
    <rect x="200" y="40" width="130" height="200" class="zone c-lift" />
    <rect x="330" y="40" width="130" height="200" class="night-zone" />
    <text x="110" y="30" text-anchor="middle" class="tb">día</text>
    <text x="265" y="30" text-anchor="middle" class="tb c-lift">crepúsculo civil</text>
    <text x="395" y="30" text-anchor="middle" class="tb">noche</text>
    <line x1="20" y1="140" x2="460" y2="140" class="ln thick" />
    <line x1="20" y1="196" x2="460" y2="196" class="ln dash thin" />
    <text x="26" y="132" class="ts">horizonte · 0°</text>
    <text x="26" y="216" class="ts">6° bajo el horizonte</text>
    <path d="M70 70L200 140L330 196" class="guide" />
    <circle cx="70" cy="70" r="14" class="sun" />
    <circle cx="200" cy="140" r="14" class="sun" />
    <circle cx="330" cy="196" r="14" class="sun" />
    <text x="200" y="174" text-anchor="middle" class="ts">puesta</text>
    <text x="330" y="234" text-anchor="middle" class="t">empieza la noche</text>
    <text x="20" y="262" class="ts">la tarde avanza →</text>
  </svg>}

  {type === 'wing-geometry' && <svg viewBox="0 0 480 346" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Un avión visto desde arriba. Una flecha de punta a punta del ala marca la envergadura. Otra, del borde de ataque al borde de fuga, marca la cuerda. En el borde de fuga, los alerones están hacia las puntas y los flaps cerca del fuselaje.</desc>
    <g transform="translate(240 170) scale(3.6)"><path d={TOP} class="pl" /></g>
    <rect x="360" y="163" width="78" height="7" class="surf c-lift" />
    <rect x="42" y="163" width="78" height="7" class="surf c-lift" />
    <rect x="266" y="164" width="88" height="7" class="surf c-drag" />
    <rect x="126" y="164" width="88" height="7" class="surf c-drag" />
    <path d={arrow(240, 92, 438, 92, 10)} class="arw thin c-ink" />
    <path d={arrow(240, 92, 42, 92, 10)} class="arw thin c-ink" />
    <text x="120" y="82" text-anchor="middle" class="tb">envergadura</text>
    <path d={arrow(146, 146, 146, 124, 8)} class="arw thin c-thrust" />
    <path d={arrow(146, 146, 146, 168, 8)} class="arw thin c-thrust" />
    <text x="16" y="216" class="tb c-thrust">cuerda</text>
    <line x1="60" y1="208" x2="140" y2="152" class="guide" />
    <text x="400" y="202" text-anchor="middle" class="t c-lift">alerón</text>
    <text x="310" y="226" text-anchor="middle" class="t c-drag">flap</text>
    <line x1="310" y1="210" x2="310" y2="174" class="guide" />
    <text x="470" y="112" text-anchor="end" class="ts">borde de ataque</text>
    <text x="470" y="230" text-anchor="end" class="ts">borde de fuga</text>
    <text x="16" y="336" class="t">alargamiento: envergadura comparada con la cuerda media</text>
  </svg>}

  {type === 'inversion' && <svg viewBox="0 0 480 306" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Un gráfico con la temperatura en el eje horizontal y la altura en el vertical. Una línea punteada muestra lo habitual: la temperatura baja al subir. La línea del día sube hacia la derecha cerca del suelo, dentro de una capa de inversión, y recién por encima de esa capa empieza a bajar. En el suelo, dentro de la capa, hay niebla o bruma. En el tope de la capa, las flechas de viento cambian de largo: arriba sopla fuerte y abajo casi calmo.</desc>
    <rect x="60" y="170" width="400" height="80" class="zone c-lift" />
    <line x1="60" y1="250" x2="460" y2="250" class="ln thin" />
    <line x1="60" y1="250" x2="60" y2="30" class="ln thin" />
    <text x="68" y="40" class="ts">altura</text>
    <text x="460" y="272" text-anchor="end" class="ts">temperatura →</text>
    <path d="M330 250L170 40" class="guide" />
    <text x="222" y="120" text-anchor="end" class="ts">habitual</text>
    <path d="M200 250L300 170L190 40" class="ln thick c-weight" />
    <text x="310" y="166" class="tb c-weight">más calor arriba</text>
    <text x="452" y="198" text-anchor="end" class="tb c-lift">capa de inversión</text>
    <text x="452" y="220" text-anchor="end" class="ts">aire quieto,</text>
    <text x="452" y="240" text-anchor="end" class="ts">niebla o bruma</text>
    <path d={arrow(372, 120, 452, 120, 10)} class="arw thin c-air" />
    <path d={arrow(372, 146, 452, 146, 10)} class="arw thin c-air" />
    <text x="372" y="104" class="t c-air">viento fuerte</text>
    <path d={arrow(80, 196, 104, 196, 8)} class="arw thin c-air" />
    <text x="16" y="298" class="t">En el tope de la capa puede haber cortante de viento</text>
  </svg>}

  {type === 'mountain-wave' && <svg viewBox="0 0 480 300" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Corte de una sierra con el viento de izquierda a derecha. Del lado de barlovento el aire sube por la ladera. Del lado de sotavento baja con fuerza y sigue en ondas. Arriba de la cresta de la onda hay una nube lenticular, y debajo de ella un rotor, una zona de aire que gira y es muy turbulenta.</desc>
    <path d="M10 262L130 262L215 120L300 262L470 262V280H10Z" class="ground" />
    <path d="M10 170C110 170 150 96 215 72C270 56 300 160 350 156C392 152 400 84 440 84C455 84 465 96 470 104" class="ln c-air" />
    <path d="M10 214C100 214 150 140 215 106C260 94 290 216 340 208C380 202 400 146 440 146C455 146 465 154 470 158" class="ln thin c-air" />
    <path d={arrow(16, 150, 74, 150, 10)} class="arw c-air" />
    <text x="16" y="138" class="tb c-air">viento</text>
    <ellipse cx="432" cy="62" rx="38" ry="11" class="cloud" />
    <text x="470" y="36" text-anchor="end" class="ts">nube lenticular</text>
    <path d={arcArrow(400, 226, 20, 20, -60, 240, 9)} class="arw thin c-red" />
    <text x="430" y="232" class="tb c-red">rotor</text>
    <path d={arrow(282, 140, 300, 196, 10)} class="arw c-red" />
    <text x="304" y="130" class="t c-red">descenso fuerte</text>
    <text x="70" y="290" text-anchor="middle" class="ts">barlovento</text>
    <text x="360" y="290" text-anchor="middle" class="ts">sotavento</text>
  </svg>}

  {type === 'variation' && <svg viewBox="0 0 480 320" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Desde un mismo punto salen dos flechas de norte: el norte verdadero, hacia arriba, y el norte magnético, 8 grados a la derecha. Una tercera flecha marca un curso de 120 grados medido desde el norte verdadero. Medido desde el norte magnético, el mismo curso es 112 grados.</desc>
    <path d={arrow(240, 210, 240, 54, 12)} class="arw c-lift" />
    <path d={arrow(240, 210, r1(240 + 156 * Math.sin(rad(8))), r1(210 - 156 * Math.cos(rad(8))), 12)} class="arw c-weight" />
    <path d={arrow(240, 210, r1(240 + 190 * Math.sin(rad(120))), r1(210 - 190 * Math.cos(rad(120))), 13)} class="arw thick c-ink" />
    <path d={arc(240, 210, 62, -90, 30)} class="ln c-lift" />
    <path d={arc(240, 210, 96, -82, 30)} class="ln c-weight" />
    <text x="232" y="46" text-anchor="end" class="tb c-lift">N verdadero</text>
    <text x="268" y="46" class="tb c-weight">N magnético</text>
    <text x="270" y="96" class="ts">variación 8° E</text>
    <text x="300" y="176" class="tb c-lift">120°</text>
    <text x="332" y="134" class="tb c-weight">112°</text>
    <text x="372" y="250" class="t">curso</text>
    <text x="16" y="300" class="tm"><tspan class="c-lift">120°</tspan> − 8° = <tspan class="c-weight">112°</tspan></text>
  </svg>}

  {type === 'taxi-wind' && <svg viewBox="0 0 480 360" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Un avión visto desde arriba, con la nariz hacia arriba. La mitad de adelante del dibujo corresponde al viento que viene de adelante y de un costado: el mando se gira hacia el viento y el elevador queda neutro en un triciclo o arriba en un patín de cola. La mitad de atrás corresponde al viento que viene de atrás y de un costado: el mando se gira en contra del viento y el elevador va abajo.</desc>
    <rect x="10" y="10" width="460" height="166" rx="12" class="zone c-lift" />
    <rect x="10" y="184" width="460" height="166" rx="12" class="zone c-weight" />
    <g transform="translate(240 180) scale(1.1)"><path d={TOP} class="pl" /></g>
    <path d={arrow(40, 40, 120, 104, 12)} class="arw c-air" />
    <text x="24" y="34" class="ts c-air">viento</text>
    <path d={arrow(440, 320, 360, 256, 12)} class="arw c-air" />
    <text x="456" y="342" text-anchor="end" class="ts c-air">viento</text>
    <text x="456" y="40" text-anchor="end" class="tb c-lift">Viento de adelante</text>
    <text x="456" y="66" text-anchor="end" class="t">mando hacia el viento</text>
    <text x="456" y="90" text-anchor="end" class="ts">el alerón de ese lado sube</text>
    <text x="456" y="114" text-anchor="end" class="ts">elevador neutro (triciclo)</text>
    <text x="456" y="136" text-anchor="end" class="ts">o arriba (patín de cola)</text>
    <text x="24" y="226" class="tb c-weight">Viento de atrás</text>
    <text x="24" y="252" class="t">mando en contra del viento</text>
    <text x="24" y="276" class="ts">el alerón de ese lado baja</text>
    <text x="24" y="300" class="ts">elevador abajo</text>
  </svg>}

  {type === 'oxygen-rule' && <svg viewBox="0 0 480 300" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Tres franjas de altura de cabina. Por debajo de 10.000 pies, unos 700 hectopascales, la regla no pide oxígeno. Entre 10.000 y 13.000 pies, de 700 a 620 hectopascales, hace falta oxígeno para la tripulación y al menos el 10 por ciento de los pasajeros durante el tramo que pase los 30 minutos. Por encima de 13.000 pies, menos de 620 hectopascales, hace falta para todos durante todo ese tramo.</desc>
    <rect x="120" y="20" width="350" height="80" rx="10" class="band-o c-red" />
    <rect x="120" y="108" width="350" height="80" rx="10" class="band-o c-drag" />
    <rect x="120" y="196" width="350" height="80" rx="10" class="band-o c-thrust" />
    <text x="16" y="108" class="tm">13.000 ft</text>
    <text x="16" y="128" class="ts">620 hPa</text>
    <text x="16" y="196" class="tm">10.000 ft</text>
    <text x="16" y="216" class="ts">700 hPa</text>
    <text x="136" y="54" class="tb c-red">Todos, todo el tramo</text>
    <text x="136" y="78" class="ts">tripulación y todos los pasajeros</text>
    <text x="136" y="142" class="tb c-drag">Pasados los 30 minutos</text>
    <text x="136" y="166" class="ts">tripulación y 10 % de los pasajeros</text>
    <text x="136" y="230" class="tb c-thrust">La regla no pide oxígeno</text>
    <text x="136" y="254" class="ts">igual vigilá los síntomas de hipoxia</text>
    <text x="16" y="294" class="ts">Altura de cabina, en atmósfera estándar</text>
  </svg>}

  {type === 'power-curve' && <svg viewBox="0 0 480 300" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Una curva en forma de U con la velocidad en el eje horizontal y el empuje necesario en el vertical. El punto más bajo es la velocidad de mínima resistencia. A la derecha de ese punto, para ir más rápido hace falta más empuje. A la izquierda, sombreada, para ir más lento también hace falta más empuje: es la zona de comando invertido.</desc>
    <rect x={drag.x0 + 2} y="40" width={drag.min[0] - drag.x0 - 2} height={drag.y0 - 40} class="zone c-red" />
    <line x1={drag.x0} y1={drag.y0} x2="464" y2={drag.y0} class="ln thin" />
    <line x1={drag.x0} y1={drag.y0} x2={drag.x0} y2="40" class="ln thin" />
    <text x="68" y="34" class="ts">empuje necesario</text>
    <path d={drag.total} class="ln thick c-ink" />
    <line x1={drag.min[0]} y1={drag.min[1]} x2={drag.min[0]} y2={drag.y0} class="guide" />
    <circle cx={drag.min[0]} cy={drag.min[1]} r="5.5" class="dot c-ink" />
    <text x={drag.min[0]} y="274" text-anchor="middle" class="ts">mínima resistencia</text>
    <text x="70" y="58" class="tb c-red">comando invertido</text>
    <text x="70" y="80" class="ts">más lento, más potencia</text>
    <text x="456" y="216" text-anchor="end" class="ts">más rápido,</text>
    <text x="456" y="236" text-anchor="end" class="ts">más potencia</text>
    <text x="464" y="292" text-anchor="end" class="ts">velocidad →</text>
  </svg>}

  {type === 'runway-perspective' && <svg viewBox="0 0 480 236" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Tres vistas de la misma pista desde la cabina, en final. Si estás bajo, la pista se ve corta y ancha. En la senda correcta, la pista crece sin cambiar de forma. Si estás alto, se ve larga y angosta.</desc>
    {runwayViews.map((v) => <g>
      <line x1={v.cx - 70} y1="46" x2={v.cx + 70} y2="46" class="ln thin" />
      <path d={`M${v.cx - v.bottom / 2} 176L${v.cx - v.top / 2} ${176 - v.h}H${v.cx + v.top / 2}L${v.cx + v.bottom / 2} 176Z`} class="runway" />
      <line x1={v.cx} y1={172} x2={v.cx} y2={180 - v.h} class="rwy-mark" />
      <text x={v.cx} y="204" text-anchor="middle" class={`tb ${v.cls}`}>{v.name}</text>
      <text x={v.cx} y="226" text-anchor="middle" class="ts">{v.note}</text>
    </g>)}
    <text x="16" y="30" class="ts">horizonte</text>
  </svg>}

  {type === 'ground-effect' && <svg viewBox="0 0 480 276" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Un gráfico con la altura sobre el suelo, medida en envergaduras, en el eje horizontal y la resistencia inducida en el vertical. Muy cerca del suelo la resistencia inducida es mucho menor. A un cuarto de envergadura es cerca de un 25 por ciento menor. A una envergadura de altura vuelve a ser la normal.</desc>
    <line x1="60" y1="230" x2="460" y2="230" class="ln thin" />
    <line x1="60" y1="230" x2="60" y2="30" class="ln thin" />
    <text x="68" y="30" class="ts">resistencia inducida</text>
    <line x1="60" y1="50" x2="460" y2="50" class="guide" />
    <text x="456" y="42" text-anchor="end" class="ts">la normal, lejos del suelo</text>
    <rect x="60" y="50" width="400" height="180" class="zone c-lift" fill-opacity=".06" />
    <path d="M100 144C120 118 135 102 160 93C220 72 300 56 460 50" class="ln thick c-lift" />
    <circle cx="160" cy="93" r="5.5" class="dot c-lift" />
    <text x="172" y="120" class="tb c-lift">un cuarto de envergadura</text>
    <text x="172" y="142" class="ts">cerca de un 25 % menos</text>
    <text x="60" y="252" text-anchor="middle" class="ts">suelo</text>
    <text x="160" y="252" text-anchor="middle" class="ts">¼</text>
    <text x="460" y="252" text-anchor="end" class="ts">1 envergadura</text>
    <text x="460" y="272" text-anchor="end" class="ts">altura sobre el suelo →</text>
  </svg>}

  {type === 'departure' && <svg viewBox="0 0 480 300" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Vista desde arriba de una pista con despegue hacia la derecha y circuito por izquierda. Tres trayectorias salen después del final de la pista: seguir derecho por el eje, virar 45 grados hacia el lado del circuito para irse, o virar 90 grados a viento cruzado para quedarse en el circuito.</desc>
    <rect x="40" y="226" width="200" height="24" rx="3" class="runway" />
    <line x1="56" y1="238" x2="224" y2="238" class="rwy-mark" />
    <path d={arrow(60, 214, 150, 214, 10)} class="arw thin c-ink" />
    <text x="40" y="206" class="ts">despegue</text>
    <path d={arrow(240, 238, 456, 238, 12)} class="arw c-lift" />
    <text x="456" y="268" text-anchor="end" class="tb c-lift">seguir derecho</text>
    <path d={qArrow(250, 238, 280, 238, 384, 134, 12)} class="arw c-thrust" />
    <text x="392" y="128" class="tb c-thrust">45° para irte</text>
    <path d={qArrow(244, 238, 268, 236, 268, 70, 12)} class="arw c-weight" />
    <text x="280" y="62" class="tb c-weight">viento cruzado</text>
    <text x="280" y="84" class="ts">para quedarte</text>
    <text x="16" y="34" class="t">Circuito por izquierda</text>
    <text x="16" y="290" class="ts">Ningún viraje antes del final de la pista</text>
  </svg>}

  {type === 'point-turns' && <svg viewBox="0 0 480 330" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Vista desde arriba de un círculo alrededor de un punto del suelo, con el viento soplando de izquierda a derecha. El avión recorre el círculo en el sentido de las agujas del reloj. Arriba, donde va con viento de cola, la inclinación es la mayor. Abajo, con viento de frente, la menor. A los costados, con viento cruzado, la inclinación es media y la nariz apunta un poco hacia el viento.</desc>
    <circle cx="240" cy="170" r="104" class="route-circle" />
    <circle cx="240" cy="170" r="6" class="dot c-ink" />
    <text x="252" y="176" class="ts">punto</text>
    <path d={arcArrow(240, 170, 104, 104, -110, -70, 11)} class="arw c-weight" />
    <path d={arcArrow(240, 170, 104, 104, 70, 110, 11)} class="arw c-thrust" />
    <path d={arcArrow(240, 170, 104, 104, -20, 20, 11)} class="arw c-lift" />
    <path d={arcArrow(240, 170, 104, 104, 160, 200, 11)} class="arw c-lift" />
    <text x="240" y="38" text-anchor="middle" class="tb c-weight">viento de cola</text>
    <text x="240" y="58" text-anchor="middle" class="ts">la mayor inclinación</text>
    <text x="240" y="300" text-anchor="middle" class="tb c-thrust">viento de frente</text>
    <text x="240" y="320" text-anchor="middle" class="ts">la menor inclinación</text>
    <text x="470" y="166" text-anchor="end" class="t c-lift">cruzado</text>
    <text x="470" y="186" text-anchor="end" class="ts">media</text>
    <text x="10" y="166" class="t c-lift">cruzado</text>
    <text x="10" y="186" class="ts">media</text>
    <path d={arrow(20, 104, 96, 104, 10)} class="arw thin c-air" />
    <text x="20" y="92" class="ts c-air">viento</text>
  </svg>}

  {type === 'stall-recovery' && <svg viewBox="0 0 480 312" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Cuatro pasos en columna. Primero bajar la nariz hasta que se apague el aviso, porque eso baja el ángulo de ataque. Segundo, nivelar las alas con alerón mientras el timón frena la guiñada. Tercero, dar la potencia que haga falta. Cuarto, volver con suavidad a la trayectoria, sin tirar de golpe.</desc>
    {recoverySteps.map((step, i) => <g>
      <rect x="16" y={16 + i * 76} width="172" height="52" rx="10" class={i === 0 ? 'box box-red' : 'box'} />
      <text x="30" y={48 + i * 76} class={`tb ${step.cls}`}><tspan class="c-lift">{i + 1}</tspan> · {step.name}</text>
      <text x="204" y={38 + i * 76} class="ts">{step.add[0]}</text>
      <text x="204" y={58 + i * 76} class="ts">{step.add[1]}</text>
      {i < recoverySteps.length - 1 && <path d={arrow(102, 70 + i * 76, 102, 90 + i * 76, 9)} class="arw thin c-ink" />}
    </g>)}
  </svg>}

  {type === 'wing-low' && <svg viewBox="0 0 480 300" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Un avión en final visto desde atrás, sobre el eje de la pista, con viento cruzado desde la izquierda. El ala izquierda, la del lado del viento, va baja para frenar la deriva. El timón va hacia la derecha para que la nariz siga alineada con el eje. La rueda izquierda va más cerca del suelo y toca primero.</desc>
    <path d="M150 290L222 150H258L330 290Z" class="runway" />
    <line x1="240" y1="284" x2="240" y2="156" class="rwy-mark" />
    <g transform="rotate(-10 240 96)">
      <line x1="150" y1="96" x2="330" y2="96" class="ln thick c-ink" />
      <circle cx="240" cy="98" r="12" class="pl" />
      <line x1="240" y1="86" x2="240" y2="58" class="ln thick c-ink" />
      <line x1="226" y1="112" x2="222" y2="128" class="ln c-ink" />
      <line x1="254" y1="112" x2="258" y2="128" class="ln c-ink" />
      <circle cx="222" cy="132" r="5" class="dot c-red" />
      <circle cx="258" cy="132" r="5" class="dot c-ink" />
    </g>
    <path d={arrow(16, 70, 96, 70, 11)} class="arw c-air" />
    <text x="16" y="56" class="tb c-air">viento</text>
    <text x="16" y="142" class="tb c-lift">ala baja</text>
    <text x="16" y="164" class="ts">del lado del viento</text>
    <text x="16" y="186" class="ts">frena la deriva</text>
    <text x="464" y="44" text-anchor="end" class="tb c-weight">timón contrario</text>
    <text x="464" y="66" text-anchor="end" class="ts">la nariz sigue el eje</text>
    <text x="464" y="176" text-anchor="end" class="t c-red">toca primero</text>
    <text x="464" y="198" text-anchor="end" class="ts">la rueda del lado</text>
    <text x="464" y="220" text-anchor="end" class="ts">del viento</text>
  </svg>}

  {type === 'airspeed-chain' && <svg viewBox="0 0 480 312" role="img" aria-labelledby={`${t} ${d}`}>
    <title id={t}>{diagramTitle}</title>
    <desc id={d}>Cuatro casillas en columna unidas por flechas. IAS es lo que marca la aguja. Sumando el error del instrumento y de la instalación se llega a CAS. Corrigiendo por densidad, es decir por altitud y temperatura, se llega a TAS, la velocidad respecto del aire. Sumando el viento se llega a GS, la velocidad sobre el suelo.</desc>
    {speedSteps.map((step, i) => <g>
      <rect x="16" y={16 + i * 76} width="104" height="52" rx="10" class="box" />
      <text x="68" y={48 + i * 76} text-anchor="middle" class={`tb speed-name ${step.cls}`}>{step.name}</text>
      <text x="140" y={37 + i * 76} class="t">{step.es}</text>
      <text x="140" y={59 + i * 76} class="ts">{step.add}</text>
      {i < speedSteps.length - 1 && <path d={arrow(68, 70 + i * 76, 68, 90 + i * 76, 9)} class="arw thin c-ink" />}
    </g>)}
  </svg>}

  <figcaption id={`diagram-caption-${uid}`}><strong>{diagramTitle}.</strong>{` ${caption}`}</figcaption>
</figure>}

