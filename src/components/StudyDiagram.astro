---
const { type, reportWhere, reportRef, instance } = Astro.props;
// Un diagrama puede repetirse dentro del mismo capitulo (p. ej. carb-ice x2 en motopropulsor).
// Los ids se derivan de la instancia, no solo del tipo, para que titulo, descripcion y
// pie sean unicos en la pagina.
const uid = instance;

// Todos los diagramas usan un viewBox de 480 de ancho. El texto se dimensiona en unidades
// del viewBox y se agranda en pantallas chicas (ver estilos) para que siga legible a 360 px.
const r1 = (n) => Math.round(n * 10) / 10;
const rad = (deg) => (deg * Math.PI) / 180;

// Flecha recta en un solo path: el trazo no tiene area, asi que el relleno solo pinta la punta.
function arrow(x1, y1, x2, y2, head = 12) {
  const len = Math.hypot(x2 - x1, y2 - y1) || 1;
  const ux = (x2 - x1) / len;
  const uy = (y2 - y1) / len;
  const h = Math.min(head, len * 0.6);
  const bx = x2 - ux * h;
  const by = y2 - uy * h;
  const w = h * 0.55;
  return `M${r1(x1)} ${r1(y1)}L${r1(bx)} ${r1(by)}M${r1(x2)} ${r1(y2)}L${r1(bx - uy * w)} ${r1(by + ux * w)}L${r1(bx + uy * w)} ${r1(by - ux * w)}Z`;
}

// Flecha curva (bezier cuadratica) con la punta orientada segun la tangente final.
function qArrow(x1, y1, cx, cy, x2, y2, head = 11) {
  const len = Math.hypot(x2 - cx, y2 - cy) || 1;
  const ux = (x2 - cx) / len;
  const uy = (y2 - cy) / len;
  const bx = x2 - ux * head;
  const by = y2 - uy * head;
  const w = head * 0.55;
  const shaft = `M${r1(x1)} ${r1(y1)}Q${r1(cx)} ${r1(cy)} ${r1(bx)} ${r1(by)}`;
  const tip = `M${r1(x2)} ${r1(y2)}L${r1(bx - uy * w)} ${r1(by + ux * w)}L${r1(bx + uy * w)} ${r1(by - ux * w)}Z`;
  // El trazo vuelve sobre si mismo para que el relleno de la curva abierta tenga area cero.
  return `${shaft}Q${r1(cx)} ${r1(cy)} ${r1(x1)} ${r1(y1)}${tip}`;
}
// Variante en dos partes, para flechas curvas punteadas (el trazo de ida y vuelta romperia el punteado).
function qArrowParts(x1, y1, cx, cy, x2, y2, head = 11) {
  const full = qArrow(x1, y1, cx, cy, x2, y2, head);
  const i = full.indexOf('Q', full.indexOf('Q') + 1);
  const j = full.indexOf('M', 1);
  return [full.slice(0, i), full.slice(j)];
}

// Flecha sobre un arco de elipse. Angulos en grados: crecen en sentido horario en pantalla.
function arcArrow(cx, cy, rx, ry, a0, a1, head = 11) {
  const pt = (a) => [cx + rx * Math.cos(rad(a)), cy + ry * Math.sin(rad(a))];
  const [x0, y0] = pt(a0);
  const [x1, y1] = pt(a1);
  const cw = a1 > a0;
  const large = Math.abs(a1 - a0) > 180 ? 1 : 0;
  let tx = -rx * Math.sin(rad(a1));
  let ty = ry * Math.cos(rad(a1));
  if (!cw) { tx = -tx; ty = -ty; }
  const tl = Math.hypot(tx, ty) || 1;
  tx /= tl; ty /= tl;
  const w = head * 0.55;
  const tipx = x1 + tx * head * 0.55;
  const tipy = y1 + ty * head * 0.55;
  const bx = x1 - tx * head * 0.45;
  const by = y1 - ty * head * 0.45;
  // Igual que en qArrow: el arco va y vuelve para no rellenar la cuerda.
  return `M${r1(x0)} ${r1(y0)}A${rx} ${ry} 0 ${large} ${cw ? 1 : 0} ${r1(x1)} ${r1(y1)}A${rx} ${ry} 0 ${large} ${cw ? 0 : 1} ${r1(x0)} ${r1(y0)}M${r1(tipx)} ${r1(tipy)}L${r1(bx - ty * w)} ${r1(by + tx * w)}L${r1(bx + ty * w)} ${r1(by - tx * w)}Z`;
}

// Arco sin punta, para marcar angulos.
function arc(cx, cy, rr, a0, a1) {
  const p0 = [cx + rr * Math.cos(rad(a0)), cy + rr * Math.sin(rad(a0))];
  const p1 = [cx + rr * Math.cos(rad(a1)), cy + rr * Math.sin(rad(a1))];
  return `M${r1(p0[0])} ${r1(p0[1])}A${rr} ${rr} 0 0 ${a1 > a0 ? 1 : 0} ${r1(p1[0])} ${r1(p1[1])}`;
}

// Perfil NACA de 4 digitos (por defecto 4412): extrados curvo, intrados casi plano.
// Borde de ataque en (0,0), borde de fuga en (c,0); y negativa hacia arriba.
function naca(m, p, t, c, n = 36) {
  const up = [];
  const lo = [];
  for (let i = 0; i <= n; i++) {
    const x = (1 - Math.cos((i / n) * Math.PI)) / 2;
    const yt = 5 * t * (0.2969 * Math.sqrt(x) - 0.126 * x - 0.3516 * x * x + 0.2843 * x ** 3 - 0.1036 * x ** 4);
    const yc = x < p ? (m / (p * p)) * (2 * p * x - x * x) : (m / (1 - p) ** 2) * (1 - 2 * p + 2 * p * x - x * x);
    const dyc = x < p ? ((2 * m) / (p * p)) * (p - x) : ((2 * m) / (1 - p) ** 2) * (p - x);
    const th = Math.atan(dyc);
    up.push([(x - yt * Math.sin(th)) * c, -(yc + yt * Math.cos(th)) * c]);
    lo.push([(x + yt * Math.sin(th)) * c, -(yc - yt * Math.cos(th)) * c]);
  }
  const pts = [...up.reverse(), ...lo.slice(1)];
  return `M${pts.map(([x, y]) => `${r1(x)} ${r1(y)}`).join('L')}Z`;
}
const AIRFOIL = naca(0.04, 0.4, 0.12, 250);

// Siluetas simplificadas de un avion de entrenamiento de ala alta. Centro de gravedad en (0,0).
// De costado (nariz hacia +x): fuselaje, ala, estabilizador y helice en un solo contorno.
const SIDE = 'M96 0C96 -6 90 -10 82 -11L52 -13L36 -14L14 -27L-22 -27L-36 -16L-98 -9L-112 -40L-128 -41L-127 -6L-122 4L-60 8C-20 14 40 14 70 9C84 7 96 5 96 0Z'
  + 'M26 -27C22 -35 -4 -36 -28 -30L-28 -27Z'
  + 'M-100 -5C-104 -9 -120 -9 -134 -6L-134 -3L-100 -3Z'
  + 'M97 -26C100 -26 100 -3 98 0C100 3 100 26 97 26C95 26 95 3 96 0C95 -3 95 -26 97 -26Z';
const SIDE_WIN = 'M33 -15L15 -25H-3V-15ZM-7 -25H-20L-31 -16H-7Z';
// Desde atras: deriva, fuselaje y ala.
const BACK = 'M-5 -15L-3 -56H3L5 -15Z'
  + 'M17 0A17 17 0 1 1 -17 0A17 17 0 1 1 17 0Z'
  + 'M-140 -9L-16 -7L16 -7L140 -9L140 -1L16 5L-16 5L-140 -1Z';
// Desde arriba, con la nariz hacia -y.
const TOP = 'M0 -40C7 -40 9 -32 9 -22L9 -15L56 -13L56 0L9 1L5 26L22 28L22 35L4 36L0 40L-4 36L-22 35L-22 28L-5 26L-9 1L-56 0L-56 -13L-9 -15L-9 -22C-9 -32 -7 -40 0 -40Z'
  + 'M-13 -43H13';

// Viraje: phi = 40 grados, peso = 110 unidades. Sustentacion = peso / cos(phi).
const turn = (() => {
  const phi = 40;
  const cx = 290;
  const cy = 200;
  const w = 110;
  const l = w / Math.cos(rad(phi));
  const lx = cx - l * Math.sin(rad(phi));
  const ly = cy - l * Math.cos(rad(phi));
  return { cx, cy, w, lx: r1(lx), ly: r1(ly) };
})();

// Vx y Vy: puntos cada minuto. Vx gana mas altura por distancia, Vy mas altura por minuto.
const climb = (() => {
  const x0 = 90;
  const g = 262;
  const vx = [1, 2, 3].map((i) => [x0 + 55 * i, g - 40 * i]);
  const vy = [1, 2, 3].map((i) => [x0 + 110 * i, g - 48 * i]);
  return { x0, g, vx, vy, vxEnd: [275, r1(g - (185 * 40) / 55)], vyEnd: [460, r1(g - (370 * 48) / 110)] };
})();

// Centro de gravedad: el avion queda quieto y lo que se mueve es el CG. Momentos respecto del
// punto donde actua la sustentacion: peso * a = cola * brazo de cola.
const cgRows = [
  { cy: 118, a: 36, title: 'CG adelante', tailNote: 'empuja más', note: 'Más estable, mandos más pesados' },
  { cy: 340, a: 14, title: 'CG atrás', tailNote: 'empuja menos', note: 'Menos estable, mandos más sensibles' },
].map((row) => {
  const x0 = 290;
  const cpx = x0 + 10;
  const tailx = x0 - 115;
  const weight = 60;
  const tail = (weight * row.a) / (cpx - tailx);
  return { ...row, x0, cpx, tailx, cgx: cpx + row.a, weight, tail: r1(tail), lift: r1(weight + tail) };
});

// Atmosfera estandar: escala de altura y temperatura.
const isa = (() => {
  const y = (km) => 300 - km * 22;
  const x = (t) => 60 + (t + 60) * 2.375;
  return { y, x };
})();

// Punto a una distancia y un rumbo (grados de brujula: 0 arriba, crece en sentido horario).
function compass(cx, cy, rr, deg) {
  return [r1(cx + rr * Math.sin(rad(deg))), r1(cy - rr * Math.cos(rad(deg)))];
}

// VOR: estacion en el centro, radiales cada 30 grados y dos aviones con curso 090 seleccionado.
const vor = (() => {
  const cx = 240;
  const cy = 184;
  const minor = [30, 60, 120, 150, 210, 240, 300, 330].map((deg) => [...compass(cx, cy, 16, deg), ...compass(cx, cy, 110, deg)]);
  const major = [0, 90, 180, 270].map((deg) => [...compass(cx, cy, 16, deg), ...compass(cx, cy, 110, deg)]);
  const hex = `M${[0, 60, 120, 180, 240, 300].map((deg) => compass(cx, cy, 11, deg + 30).join(' ')).join('L')}Z`;
  const cdis = [
    { cx: 130, badge: 'A', flag: 'TO', cls: 'c-lift' },
    { cx: 350, badge: 'B', flag: 'FROM', cls: 'c-weight' },
  ];
  return { cx, cy, minor, major, hex, cdis };
})();

// ADF: rumbo 030, aguja en 060 relativo, estacion a 090 magnetico (el ejemplo de la leccion).
const adf = (() => {
  const p = [120, 270];
  const dial = [390, 116];
  return {
    p,
    dial,
    north: compass(p[0], p[1], 196, 0),
    head: compass(p[0], p[1], 190, 30),
    needle: compass(dial[0], dial[1], 42, 60),
    tail: compass(dial[0], dial[1], 18, 240),
    ticks: Array.from({ length: 12 }, (_, i) => [...compass(dial[0], dial[1], 42, i * 30), ...compass(dial[0], dial[1], 50, i * 30)]),
  };
})();

// Velocimetro: s va de 0 a 1 sobre 300 grados. Marcas de ejemplo, sin valores de un avion real.
const asi = (() => {
  const cx = 240;
  const cy = 150;
  const ang = (s) => -70 + 300 * s;
  const pt = (rr, s) => [r1(cx + rr * Math.cos(rad(ang(s)))), r1(cy + rr * Math.sin(rad(ang(s))))];
  const ticks = Array.from({ length: 21 }, (_, i) => {
    const s = i / 20;
    const [x1, y1] = pt(i % 2 ? 111 : 103, s);
    const [x2, y2] = pt(118, s);
    return `M${x1} ${y1}L${x2} ${y2}`;
  }).join('');
  const band = (rr, a, b) => arc(cx, cy, rr, ang(a), ang(b));
  return {
    cx,
    cy,
    ticks,
    white: band(90, 0.18, 0.42),
    green: band(103, 0.22, 0.66),
    yellow: band(103, 0.66, 0.86),
    red: [...pt(84, 0.86), ...pt(119, 0.86)],
    needle: pt(92, 0.47),
  };
})();
const asiLegend = [
  { cls: 'asi-white', title: 'Arco blanco', lines: ['uso de flaps', 'de VS0 a VFE'], x: 20, y: 316 },
  { cls: 'asi-green', title: 'Arco verde', lines: ['operación normal', 'de VS1 a VNO'], x: 250, y: 316 },
  { cls: 'asi-yellow', title: 'Arco amarillo', lines: ['solo con aire calmo', 'de VNO a VNE'], x: 20, y: 400 },
  { cls: 'asi-red', title: 'Línea roja', lines: ['VNE: nunca', 'la superes'], x: 250, y: 400 },
];

// Resbale, coordinado y derrape en un viraje a la derecha. Cada columna: vista desde arriba
// (el avion sobre la trayectoria) y la bola del inclinometro.
const slipCols = [
  { cx: 82, title: 'Resbale', yaw: -22, ball: 66, cls: 'c-weight', ballNote: 'bola adentro', noseNote: 'gira de menos' },
  { cx: 240, title: 'Coordinado', yaw: 0, ball: 90, cls: 'c-thrust', ballNote: 'bola centrada', noseNote: 'gira justo' },
  { cx: 398, title: 'Derrape', yaw: 22, ball: 114, cls: 'c-weight', ballNote: 'bola afuera', noseNote: 'gira de más' },
].map((col) => ({
  ...col,
  ballX: r1(col.cx + 56 * Math.cos(rad(col.ball))),
  ballY: r1(196 + 56 * Math.sin(rad(col.ball))),
}));

