    <rect x="337" y="102" width="50" height="40" rx="4" class="load" />
    <text x="362" y="92" text-anchor="middle" class="t">200 kg</text>
    <rect x="40" y="142" width="430" height="8" rx="2" class="pl" />
    <path d="M188.7 150L170 186H207.4Z" class="fulcrum" />
    <text x="216" y="178" class="tb c-lift">CG</text>
    <line x1="102" y1="150" x2="102" y2="226" class="guide" />
