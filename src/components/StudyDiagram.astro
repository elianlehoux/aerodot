const caption = captions[type];
const diagramTitle = title[type];
const t = `diagram-title-${type}-${uid}`;
const d = `diagram-desc-${type}-${uid}`;
const papiRows = [
  { label: 'Muy alto', white: 4, off: -18 },
  { label: 'Un poco alto', white: 3, off: -9 },
  { label: 'En la senda', white: 2, off: 0 },
  { label: 'Un poco bajo', white: 1, off: 9 },
  { label: 'Muy bajo', white: 0, off: 18 },
];
const loopNodes = [
  { n: 1, label: 'Observar', x: 240, y: 40 },
