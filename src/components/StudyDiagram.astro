    <text x="271" y="122" text-anchor="middle" class="small">baja la presión</text>
    <text x="271" y="142" text-anchor="middle" class="small">baja la temperatura</text>
    <rect x="388" y="78" width="140" height="72" rx="8" class="node" />
    <text x="458" y="108" text-anchor="middle" class="label">Mariposa</text>
    <text x="458" y="128" text-anchor="middle" class="small">puede acumular hielo</text>
    <rect x="570" y="78" width="124" height="72" rx="8" class="node" />
    <text x="632" y="120" text-anchor="middle" class="label">Motor</text>
    <path d="M154 114H196M346 114H388M528 114H570" class="pipe pipe-blue" marker-end="url(#arrow-carb-${uid})" />
    <text x="360" y="214" text-anchor="middle" class="small">El combustible se vaporiza y absorbe calor: el enfriamiento no depende solo del aire exterior.</text>
  </svg>}

  {type === 'atmosphere' && <svg viewBox="0 0 720 280" role="img" aria-labelledby={`diagram-title-atmo-${uid} diagram-desc-atmo-${uid}`}>
    <title id={`diagram-title-atmo-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-atmo-${uid}`}>Una columna de altura. Abajo, nivel del mar con 15 grados y 1013 hectopascales. La temperatura disminuye hasta la tropopausa, cerca de 11 kilómetros. La presión disminuye en toda la columna y más rápido cerca del suelo.</desc>
    <line x1="168" y1="36" x2="168" y2="228" class="axis" />
    <line x1="150" y1="214" x2="186" y2="214" class="datum" />
