    <g transform="translate(52 236) rotate(90) scale(.55)"><path d={TOP} class="pl pl-give" /></g>
    <g transform="translate(188 236) rotate(-90) scale(.55)"><path d={TOP} class="pl pl-give" /></g>
    <text x="52" y="288" text-anchor="middle" class="ts c-weight">cede</text>
    <text x="188" y="196" text-anchor="middle" class="ts c-weight">cede</text>
