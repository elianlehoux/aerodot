    <text x="612" y="40" class="small">CL</text>
    <text x="676" y="236" text-anchor="middle" class="small">α</text>
    <text x="676" y="58" text-anchor="middle" class="small">CL máx.</text>
    <text x="360" y="276" text-anchor="middle" class="caption">Después del máximo, más ángulo ya no da más sustentación: es la pérdida.</text>
  </svg>}

  {type === 'carb-ice' && <svg viewBox="0 0 720 250" role="img" aria-labelledby={`diagram-title-carb-${uid} diagram-desc-carb-${uid}`}>
    <title id={`diagram-title-carb-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-carb-${uid}`}>El aire entra, se acelera en el venturi y se mezcla con combustible que se vaporiza. Esa zona se enfría. El hielo puede estrechar el paso junto a la mariposa antes de llegar al motor.</desc>
    <defs><marker id={`arrow-carb-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker></defs>
