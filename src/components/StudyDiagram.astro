    <line x1="154" y1="52" x2="182" y2="52" class="guide" />
    <text x="148" y="218" text-anchor="end" class="label">Nivel del mar</text>
    <text x="148" y="200" text-anchor="end" class="small">15 °C · 1013 hPa</text>
    <text x="196" y="124" class="label">Troposfera</text>
    <text x="196" y="144" class="small">cerca de −6,5 °C cada 1000 m</text>
    <text x="196" y="56" class="label label-blue">Tropopausa · ~11 km</text>
    <text x="196" y="76" class="small">después, el modelo deja de enfriar igual</text>
    <text x="360" y="258" text-anchor="middle" class="caption">1 hPa cerca del suelo equivale a unos 27–30 ft. Más arriba, esa equivalencia cambia.</text>
  </svg>}

  {type === 'front' && <svg viewBox="0 0 720 260" role="img" aria-labelledby={`diagram-title-front-${uid} diagram-desc-front-${uid}`}>
    <title id={`diagram-title-front-${uid}`}>{diagramTitle}</title>
    <desc id={`diagram-desc-front-${uid}`}>Una cuña de aire frío avanza y levanta el aire más cálido a lo largo de una pendiente. Sobre esa pendiente hay nubosidad de desarrollo. El esquema no tiene escala ni horario.</desc>
    <defs><marker id={`arrow-front-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker></defs>
