    <desc id={`diagram-desc-landing-${uid}`}>Una trayectoria esquemática, sin escala geométrica, llega al entorno del umbral. No representa una senda, altura, velocidad ni punto prescripto de toma.</desc>
    <defs><marker id={`arrow-landing-${uid}`} markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z" fill="currentColor" /></marker></defs>
