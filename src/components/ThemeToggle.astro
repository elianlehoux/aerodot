<button type="button" class="ld-dn" role="switch" aria-checked="false" aria-label="Cambiar a modo oscuro" title="Cambiar a modo oscuro">
  <span class="theme-toggle-track" aria-hidden="true">
    <span class="theme-toggle-indicator"></span>
    <animate-icons class="theme-icon theme-icon-sun" name="sun" size="16"></animate-icons>
    <animate-icons class="theme-icon theme-icon-moon" name="moon" size="16"></animate-icons>
  </span>
</button>
