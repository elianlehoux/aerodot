---
interface Props {
  variant?: 'home' | 'study';
}

const { variant = 'study' } = Astro.props;
---
<footer class:list={['home-footer', { 'study-foot': variant === 'study' }]}>
  <div class="footer-row">
    <div class="footer-main"><slot /></div>
    <nav class="footer-links" aria-label="Pie de página">
      <a href="https://cafecito.app/aerodot" target="_blank" rel="noreferrer">Apoyá el proyecto<span class="visually-hidden">. Se abre en una pestaña nueva.</span></a>
      <button class="footer-install" type="button" data-install-app hidden>
        <animate-icons name="download" size="13"></animate-icons>
        Instalar app
      </button>
      <a href="/terminos">Términos</a>
      <a href="/privacidad">Privacidad</a>
    </nav>
  </div>
  <div class="footer-note"><slot name="note" /></div>
</footer>
