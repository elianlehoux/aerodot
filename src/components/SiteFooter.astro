---
interface Props {
  variant?: 'home' | 'study';
}

const { variant = 'study' } = Astro.props;
---
<footer class:list={['home-footer', { 'study-foot': variant === 'study' }]}>
  <slot />
  <nav class="footer-legal" aria-label="Legal">
    <a href="/terminos">Términos</a>
    <a href="/privacidad">Privacidad</a>
  </nav>
  <a class="footer-support" href="https://cafecito.app/aerodot" target="_blank" rel="noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5.5 8.5h10v4.2a3.6 3.6 0 0 1-3.6 3.6H9.1a3.6 3.6 0 0 1-3.6-3.6V8.5z" />
      <path d="M15.5 9.5h1.4a2.4 2.4 0 0 1 0 4.8h-1.4" />
      <path d="M8 19.5h8" />
    </svg>
    <span>Apoyá el proyecto para más herramientas gratis</span>
    <span class="visually-hidden">. Se abre en una pestaña nueva.</span>
  </a>
</footer>
